# pacman install script (Arch, CachyOS, EndeavourOS, Manjaro): the same steps as the .deb and the .rpm.

post_install() {
	/usr/lib/riftlinux/after-install.sh
}

post_upgrade() {
	/usr/lib/riftlinux/after-install.sh
}

pre_remove() {
	/usr/lib/riftlinux/before-remove.sh
}
