[Desktop Entry]
Type=Application
Name=Oculus Rift CV1 driver (RiftLinux)
Comment=Keeps the Rift CV1 driver registered with SteamVR
Exec=/usr/bin/riftlinux-setup register --quiet
NoDisplay=true
Terminal=false
X-GNOME-Autostart-enabled=true
