CHECKS = [check_arch, check_steam, check_package, check_registered, check_sandboxed, check_nvidia_vrr, check_enabled, check_devices, check_access, check_display,
          check_priority, check_openxr, check_chaperone, check_settings, check_realtime, check_calibration, check_native]
