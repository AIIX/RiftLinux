            sync_user_copy(src, print, dst)
            openvrpaths_register(dst, print, config_dir)

    return result("sandboxed", title, "fix",
                  ", ".join(n for n, _, _ in missing) + " Steam: the driver is copied where it can read it and registered.",
                  fix, "user")


# --------------------------------------------------------------------------------------------------------------------
# NVIDIA and adaptive sync on Wayland: with any connected monitor offering VRR, NVIDIA flips a leased
# display (the headset on Wayland) without vsync, so the lower part of the picture tears and lags when the head turns
# (NVIDIA open-gpu-kernel-modules #992). The fix hides VRR from NVIDIA, which takes it away from the monitors too: the
# user's choice, never done by the package or by install/repair.

NVIDIA_VRR_CONF = "/etc/modprobe.d/riftlinux-nvidia-vrr.conf"
NVIDIA_VRR_OPTION = "options nvidia-modeset conceal_vrr_caps=1"


def nvidia_loaded():
    return os.path.exists("/proc/driver/nvidia/version")


def vrr_concealed_in_config():
    """A modprobe.d file setting conceal_vrr_caps=1 (ours or the user's own)."""
    for d in ("/etc/modprobe.d", "/usr/lib/modprobe.d", "/lib/modprobe.d", "/run/modprobe.d"):
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if not n.endswith(".conf"):
                continue
            try:
                for line in open(os.path.join(d, n), errors="replace"):
                    line = line.split("#", 1)[0]
                    if "nvidia-modeset" in line.replace("_", "-") and "conceal_vrr_caps=1" in line:
                        return os.path.join(d, n)
            except OSError:
                pass
    return None


def vrr_monitors():
    """Connected connectors whose monitor offers adaptive sync (the kernel's vrr_capable), read without DRM master."""
    import ctypes
    import fcntl

    def iowr(nr, size):
        return (3 << 30) | (size << 16) | (ord("d") << 8) | nr

    class Res(ctypes.Structure):
        _fields_ = [(n, ctypes.c_uint64) for n in ("fbs", "crtcs", "conns", "encs")] + \
                   [(n, ctypes.c_uint32) for n in ("n_fbs", "n_crtcs", "n_conns", "n_encs", "minw", "maxw", "minh",
                                                    "maxh")]

    class Props(ctypes.Structure):
        _fields_ = [("ids", ctypes.c_uint64), ("vals", ctypes.c_uint64), ("count", ctypes.c_uint32),
                    ("obj", ctypes.c_uint32), ("type", ctypes.c_uint32)]

    class Prop(ctypes.Structure):
        _fields_ = [("values", ctypes.c_uint64), ("blobs", ctypes.c_uint64), ("id", ctypes.c_uint32),
                    ("flags", ctypes.c_uint32), ("name", ctypes.c_char * 32), ("n_values", ctypes.c_uint32),
                    ("n_blobs", ctypes.c_uint32)]

    class Conn(ctypes.Structure):
        _fields_ = [(n, ctypes.c_uint64) for n in ("encs", "modes", "props", "vals")] + \
                   [(n, ctypes.c_uint32) for n in ("n_modes", "n_props", "n_encs", "enc", "id", "type", "type_id",
                                                    "connection", "mmw", "mmh", "subpixel", "pad")]

    types = {10: "DP", 11: "HDMI-A", 14: "eDP", 3: "DVI-D"}
    found = []
    for card in sorted(glob.glob("/dev/dri/card*")):
        try:
            fd = os.open(card, os.O_RDWR)
        except OSError:
            continue
        try:
            res = Res()
            fcntl.ioctl(fd, iowr(0xA0, ctypes.sizeof(Res)), res)
            ids = (ctypes.c_uint32 * res.n_conns)()
            res2 = Res(conns=ctypes.addressof(ids), n_conns=res.n_conns)
            fcntl.ioctl(fd, iowr(0xA0, ctypes.sizeof(Res)), res2)
            for cid in ids:
                c = Conn(id=cid)
                fcntl.ioctl(fd, iowr(0xA7, ctypes.sizeof(Conn)), c)
                if c.connection != 1:
                    continue
                pr = Props(obj=cid, type=0xC0C0C0C0)
                fcntl.ioctl(fd, iowr(0xB9, ctypes.sizeof(Props)), pr)
                pids = (ctypes.c_uint32 * pr.count)()
                pvals = (ctypes.c_uint64 * pr.count)()
                pr2 = Props(ids=ctypes.addressof(pids), vals=ctypes.addressof(pvals), count=pr.count, obj=cid,
                            type=0xC0C0C0C0)
                fcntl.ioctl(fd, iowr(0xB9, ctypes.sizeof(Props)), pr2)
                for pid, val in zip(pids, pvals):
                    gp = Prop(id=pid)
                    fcntl.ioctl(fd, iowr(0xAA, ctypes.sizeof(Prop)), gp)
                    if gp.name == b"vrr_capable" and val == 1:
                        found.append(f"{types.get(c.type, 'connector')}-{c.type_id}")
        except OSError:
            pass
        finally:
            os.close(fd)
    return found


def initramfs_cmd():
    for tool, cmd in (("update-initramfs", "update-initramfs -u"), ("dracut", "dracut -f"),
                      ("mkinitcpio", "mkinitcpio -P")):
        if shutil.which(tool):
            return cmd
    return None


def desktop_session_type():
    """The desktop session's type (wayland, x11), also when run from an SSH login or a service, where the shell's own
    variables say nothing: the user's session on a seat, from logind."""
    t = os.environ.get("XDG_SESSION_TYPE")
    if t in ("wayland", "x11"):
        return t
    if os.environ.get("WAYLAND_DISPLAY"):
        return "wayland"
    if shutil.which("loginctl"):
        r = run(["loginctl", "list-sessions", "--no-legend"])
        for line in (r.stdout.splitlines() if r is not None and r.returncode == 0 else []):
            f = line.split()
            # SESSION UID USER SEAT ...: this user's session on a seat.
            if len(f) >= 4 and f[1] == str(os.getuid()) and f[3].startswith("seat"):
                q = run(["loginctl", "show-session", f[0], "-p", "Type", "--value"])
                if q is not None and q.returncode == 0 and q.stdout.strip() in ("wayland", "x11"):
                    return q.stdout.strip()
    return "x11" if os.environ.get("DISPLAY") else None


def nvidia_major():
    """The NVIDIA kernel module's major version (615 for 615.78.08), 0 if unknown."""
    try:
        return int(open("/sys/module/nvidia/version").read().split(".")[0])
    except (OSError, ValueError):
        return 0


# The headset's picture tore on Wayland with drivers 570-580 and a VRR monitor; not with 615 here (KDE Plasma 6.8), but
# others report it with 615 too. NVIDIA names no fixed version: from 615 on the check only informs.
NVIDIA_VRR_TEAR_FIXED_MAJOR = 615


def check_nvidia_vrr(p, opts):
    title = "NVIDIA and adaptive sync (Wayland)"
    if not nvidia_loaded():
        return result("nvidia-vrr", title, "ok", "not an NVIDIA GPU")
    conf = vrr_concealed_in_config()
    monitors = vrr_monitors()
    wayland = desktop_session_type() == "wayland"
    if conf and monitors:
        return result("nvidia-vrr", title, "warn",
                      f"VRR is hidden from NVIDIA by {conf}, but not yet in effect ({', '.join(monitors)} still offer "
                      "it): reboot.")
    if conf:
        return result("nvidia-vrr", title, "ok", f"VRR hidden from NVIDIA ({conf}): the headset is in sync on Wayland.")
    if not monitors:
        return result("nvidia-vrr", title, "ok", "no monitor offers adaptive sync")
    major = nvidia_major()
    if major >= NVIDIA_VRR_TEAR_FIXED_MAJOR:
        return result("nvidia-vrr", title, "info",
                      f"{', '.join(monitors)} with VRR and NVIDIA {major}: the headset tore with drivers 570-580 on "
                      "Wayland; it did not here with 615 on KDE Plasma, but others report it with 615 too (NVIDIA's "
                      "bug, https://github.com/NVIDIA/open-gpu-kernel-modules/issues/992). If the lower part of the "
                      "picture tears: `riftlinux-setup nvidia-vrr conceal`.")
    detail = (f"{', '.join(monitors)} offer(s) adaptive sync (VRR); with NVIDIA, on Wayland the headset's frames are "
              "shown without vsync and the lower part of the picture tears and lags when you turn your head. Fix "
              "(your monitors lose VRR): `riftlinux-setup nvidia-vrr conceal`, then reboot.")
    if not wayland:
        return result("nvidia-vrr", title, "info", "only on Wayland, not in an X11 session: " + detail)
    return result("nvidia-vrr", title, "warn", detail)


def cmd_nvidia_vrr(p, opts):
    if opts.action == "status":
        report([check_nvidia_vrr(p, opts)], opts.json)
        return 0
    if not nvidia_loaded():
        print("Not an NVIDIA GPU: nothing to do.")
        return 0
    rebuild = initramfs_cmd()
    if opts.action == "conceal":
        if vrr_concealed_in_config():
            print(f"Already set ({vrr_concealed_in_config()}); reboot if the check still shows VRR.")
            return 0
        print("This hides adaptive sync (VRR) from the NVIDIA driver: the headset's picture is then in sync on "
              "Wayland, and your monitors no longer offer VRR (on X11 too) until `riftlinux-setup nvidia-vrr "
              "restore`.")
        if not ask(opts, "Hide VRR from NVIDIA?"):
            return 1
        cmds = [f"printf '%s\\n' '# RiftLinux: the headset in sync on Wayland (riftlinux-setup nvidia-vrr)' "
                f"'{NVIDIA_VRR_OPTION}' > {NVIDIA_VRR_CONF}"]
    else:
        if not os.path.exists(NVIDIA_VRR_CONF):
            other = vrr_concealed_in_config()
            print(f"Not set by RiftLinux{f' (set in {other}: remove that line yourself)' if other else ''}.")
            return 0
        if not ask(opts, "Give adaptive sync (VRR) back to NVIDIA? The headset may tear again on Wayland."):
            return 1
        cmds = [f"rm -f {NVIDIA_VRR_CONF}"]
    if rebuild:
        cmds.append(rebuild)
    if not run_root(cmds, opts):
        return 1
    print("Done. Reboot for it to take effect.")
    return 0


def check_enabled(p, opts):
    if not p.vrsettings:
        return result("enabled", "Driver enabled in SteamVR", "info", "No SteamVR settings yet.")
    vs = read_json(p.vrsettings) or {}
    sect = vs.get("driver_" + DRIVER_NAME, {})
    blocked = bool(sect.get("blocked_by_safe_mode"))
    disabled = sect.get("enable") is False

    def fix():
        vs2 = read_json(p.vrsettings) or {}
        s2 = vs2.setdefault("driver_" + DRIVER_NAME, {})
        s2["blocked_by_safe_mode"] = False
        s2["enable"] = True
        write_json(p.vrsettings, vs2, indent=3)

    if blocked or disabled:
        why = []
        if blocked:
            why.append("SteamVR blocked it after a crash (safe mode)")
        if disabled:
            why.append("it is switched off in SteamVR's add-ons")
        return result("enabled", "Driver enabled in SteamVR", "fix", " and ".join(why) + "; it will be enabled again.",
                      fix, "user")
    return result("enabled", "Driver enabled in SteamVR", "ok", "Enabled, not blocked.")


def usb_devices():
    devs = []
    base = "/sys/bus/usb/devices"
    try:
        names = os.listdir(base)
    except OSError:
        return devs
    for n in sorted(names):
        d = os.path.join(base, n)
        if sysfs(d, "idVendor") != VENDOR:
            continue
        prod = sysfs(d, "idProduct")
        bus, dev = sysfs(d, "busnum"), sysfs(d, "devnum")
        node = f"/dev/bus/usb/{int(bus):03d}/{int(dev):03d}" if bus and dev else None
        devs.append({"sysfs": d, "product": prod, "name": PRODUCTS.get(prod, f"Oculus device {prod}"),
                     "speed": sysfs(d, "speed"), "node": node,
                     "access": bool(node and os.access(node, os.R_OK | os.W_OK))})
    return devs


def hidraw_nodes():
    out = []
    base = "/sys/class/hidraw"
    try:
        names = os.listdir(base)
    except OSError:
        return out
    for n in sorted(names):
        d = os.path.realpath(os.path.join(base, n, "device"))
        while d and d != "/":
            if sysfs(d, "idVendor") == VENDOR:
                node = os.path.join("/dev", n)
                out.append({"node": node, "access": os.access(node, os.R_OK | os.W_OK)})
                break
            d = os.path.dirname(d)
    return out


def check_devices(p, opts):
    devs = usb_devices()
    hmd = [d for d in devs if d["product"] == "0031"]
    sensors = [d for d in devs if d["product"] == "0211"]
    if not hmd:
        return result("devices", "Rift connected", "warn",
                      "No Rift CV1 headset on USB (plug in its USB and HDMI cables; the headset's box must be on).")
    parts = ["headset"]
    slow = [s for s in sensors if s["speed"] and float(s["speed"]) < 5000]
    parts.append(f"{len(sensors)} sensor(s)" + (f", {len(slow)} on USB 2 (works, lower frame rate; USB 3 is best)" if slow else ""))
    state = "ok" if sensors else "warn"
    if not sensors:
        parts.append("no sensor found: tracking needs at least one")
    return result("devices", "Rift connected", state, ", ".join(parts) + ".")


def package_install_cmd(package):
    """The distribution's command to install a package, or None when no known package manager is present."""
    for tool, cmd in (("apt-get", f"apt-get install -y {package}"),
                      ("pacman", f"pacman -S --needed --noconfirm {package}"),
                      ("dnf", f"dnf install -y {package}"),
                      ("zypper", f"zypper --non-interactive install {package}"),
                      ("apk", f"apk add {package}")):
        if shutil.which(tool):
            return cmd
    return None


def check_lsusb(p, opts):
    # SteamVR's client library answers Steam's "is a headset connected?" by matching the drivers' USB ids with the
    # lsusb command. Without it Steam cannot know the Rift is there before SteamVR runs.
    title = "Steam's headset detection"
    if shutil.which("lsusb"):
        return result("lsusb", title, "ok", "lsusb is installed; Steam can tell that the Rift is connected.")
    detail = ("The lsusb command (package usbutils) is missing. SteamVR's client library runs it to tell Steam that a "
              "headset is connected, so without it Steam does not know the Rift is there before SteamVR runs.")
    cmd = package_install_cmd("usbutils")
    if cmd:
        return result("lsusb", title, "fix", detail + " It will be installed.", None, "root", [cmd])
    return result("lsusb", title, "error", detail + " Install the usbutils package with your package manager.")


def udev_rules_text():
    return ("# Oculus Rift CV1: headset, sensors and the Touch controllers' radio (USB vendor 2833), for the user at\n"
            "# the machine (uaccess; no group needed). Installed by riftlinux-setup.\n"
            f'SUBSYSTEM=="usb", ATTRS{{idVendor}}=="{VENDOR}", MODE="0660", TAG+="uaccess"\n'
            f'SUBSYSTEM=="hidraw", ATTRS{{idVendor}}=="{VENDOR}", MODE="0660", TAG+="uaccess"\n'
            "# No USB autosuspend, also after the camera driver (uvcvideo) binds to a sensor.\n"
            f'SUBSYSTEM=="usb", ENV{{DEVTYPE}}=="usb_device", ATTR{{idVendor}}=="{VENDOR}", ATTR{{power/control}}="on"\n'
            f'ACTION=="bind", SUBSYSTEM=="usb", ENV{{DEVTYPE}}=="usb_interface", DRIVER=="uvcvideo", '
            f'ATTRS{{idVendor}}=="{VENDOR}", RUN+="/bin/sh -c \'echo on > /sys%p/../power/control\'"\n')


def check_access(p, opts):
    devs = usb_devices()
    hid = hidraw_nodes()
    if not devs:
        installed = any(os.path.exists(os.path.join(d, UDEV_NAME)) for d in ("/etc/udev/rules.d", "/usr/lib/udev/rules.d"))
        return result("access", "Device access", "info" if installed else "fix",
                      "Rules installed; plug in the Rift to check access." if installed else
                      "No rules for the Rift's devices yet (needed to use them without root).",
                      None, "root" if not installed else None, [] if installed else udev_root_cmds(p))
    missing = [d["node"] for d in devs if not d["access"]] + [h["node"] for h in hid if not h["access"]]
    if not missing:
        return result("access", "Device access", "ok", f"{len(devs)} USB devices and {len(hid)} HID interfaces usable.")
    return result("access", "Device access", "fix", "No access to " + ", ".join(missing) + ": udev rules needed.",
                  None, "root", udev_root_cmds(p))


def check_usb_power(p, opts):
    title = "USB power saving"
    devs = usb_devices()
    if not devs:
        return result("usbpower", title, "info", "Plug in the Rift to check.")
    auto = [d for d in devs if sysfs(d["sysfs"], "power/control") == "auto"]
    if not auto:
        return result("usbpower", title, "ok", "Off for the Rift's devices.")
    # The package's udev rules switch it off for devices that appear after they are installed (and again after the
    # camera driver binds to a sensor); these were set before, or by an older rule.
    cmds = [f"sh -c 'echo on > {d['sysfs']}/power/control'" for d in auto]
    return result("usbpower", title, "fix",
                  ", ".join(sorted({d["name"] for d in auto})) + " may be suspended when idle (USB autosuspend); "
                  "it will be switched off for them.",
                  None, "root", cmds)


def udev_root_cmds(p):
    src = p.udev_src if os.path.exists(p.udev_src) else None
    target = f"/etc/udev/rules.d/{UDEV_NAME}"
    if src:
        install = f"install -m 0644 '{src}' {target}"
    else:
        install = f"printf %s {json.dumps(udev_rules_text())} > {target}"
    return [install, "udevadm control --reload-rules", f"udevadm trigger --attr-match=idVendor={VENDOR}"]


def file_has_cap(path, cap):
    try:
        data = os.getxattr(path, "security.capability")
    except OSError:
        return False
    if len(data) < 12:
        return False
    permitted = struct.unpack_from("<I", data, 4)[0]
    return bool(permitted & (1 << cap))


def check_priority(p, opts):
    if not p.steamvr:
        return result("priority", "SteamVR compositor priority", "info", "SteamVR not found.")
    launcher = os.path.join(p.steamvr, "bin", "linux64", "vrcompositor-launcher")
    if not os.path.exists(launcher):
        return result("priority", "SteamVR compositor priority", "info", "No vrcompositor-launcher in this SteamVR.")
    if file_has_cap(launcher, CAP_SYS_NICE):
        return result("priority", "SteamVR compositor priority", "ok", "vrcompositor-launcher has CAP_SYS_NICE.")
    return result("priority", "SteamVR compositor priority", "fix",
                  "vrcompositor-launcher lacks CAP_SYS_NICE (SteamVR updates remove it): its compositor would run at "
                  "normal priority.", None, "root", [f"setcap CAP_SYS_NICE=eip '{launcher}'"])


def openxr_runtime(p):
    if not os.path.exists(p.openxr_active):
        return "none", None
    target = os.path.realpath(p.openxr_active)
    j = read_json(p.openxr_active) or {}
    rt = j.get("runtime", {})
    if rt.get("VALVE_runtime_is_steamvr") or "steamxr" in os.path.basename(target):
        return "steamvr", target
    name = (rt.get("name") or os.path.basename(target)).lower()
    if "monado" in name or "monado" in (rt.get("library_path") or ""):
        return "monado", target
    return "other", target


def check_openxr(p, opts):
    kind, target = openxr_runtime(p)
    want = getattr(opts, "openxr", None)
    steamxr = os.path.join(p.steamvr, "steamxr_linux64.json") if p.steamvr else None

    def fix():
        backup_link(p.openxr_active)
        os.makedirs(os.path.dirname(p.openxr_active), exist_ok=True)
        tmp = p.openxr_active + ".tmp-riftlinux"
        if os.path.lexists(tmp):
            os.unlink(tmp)
        os.symlink(steamxr, tmp)
        os.replace(tmp, p.openxr_active)

    if kind == "steamvr":
        return result("openxr", "OpenXR runtime", "ok", "SteamVR (OpenXR games go through SteamVR and this driver).")
    if not steamxr or not os.path.exists(steamxr):
        return result("openxr", "OpenXR runtime", "info", f"{kind}; SteamVR's OpenXR runtime file not found.")
    if kind == "none":
        if want == "keep":
            return result("openxr", "OpenXR runtime", "warn", "None set: OpenXR games will open on the monitor.")
        return result("openxr", "OpenXR runtime", "fix",
                      "None set: OpenXR games (PLAY'A VR and others) would open on the monitor; SteamVR will be set.",
                      fix, "user")
    # Another runtime (Monado service, WiVRn, ALVR...): the user's choice, changed only when asked (fix asks for it).
    if want == "steamvr" or getattr(opts, "force", False):
        return result("openxr", "OpenXR runtime", "fix", f"{kind} ({target}) will be replaced by SteamVR.", fix, "user")
    return result("openxr", "OpenXR runtime", "warn",
                  f"Another runtime is active ({kind}: {target}); OpenXR games will not use SteamVR. "
                  "`riftlinux-setup install --openxr steamvr` switches.")


def default_universe():
    h = 2.43
    corners = [(-1, -1), (1, -1), (1, 1), (-1, 1)]
    walls = []
    for i in range(4):
        (x0, z0), (x1, z1) = corners[i], corners[(i + 1) % 4]
        walls.append([[x0, 0, z0], [x0, h, z0], [x1, h, z1], [x1, 0, z1]])
    return {"collision_bounds": walls, "play_area": [2, 2],
            "seated": {"translation": [0, 0, 0], "yaw": 0},
            "standing": {"translation": [0, 0, 0], "yaw": 0},
            "time": datetime.datetime.now().strftime("%a %b %d %H:%M:%S %Y"), "universeID": UNIVERSE}


def check_chaperone(p, opts):
    if not p.chaperone:
        return result("room", "Room setup", "info", "No SteamVR config directory yet.")
    c = read_json(p.chaperone) or {}
    uni = next((u for u in c.get("universes", []) if str(u.get("universeID")) == UNIVERSE), None)
    complete = uni is not None and uni.get("play_area") and uni.get("collision_bounds") and "standing" in uni and \
        "seated" in uni and uni.get("time")

    def fix():
        c2 = read_json(p.chaperone) or {"jsonid": "chaperone_info", "version": 5, "universes": []}
        c2.setdefault("universes", [])
        u = next((u for u in c2["universes"] if str(u.get("universeID")) == UNIVERSE), None)
        d = default_universe()
        if u is None:
            c2["universes"].append(d)
        else:
            for k, v in d.items():
                if not u.get(k):
                    u[k] = v
        write_json(p.chaperone, c2, indent=3)

    if complete:
        return result("room", "Room setup", "ok", "Standing and seated set, 2 x 2 m bounds or your own.")
    # The driver gives SteamVR a standing room itself at each start when none is set up: nothing to
    # write. `repair` still writes one, for a driver older than that.
    return result("room", "Room setup", "ok",
                  "None saved: the driver gives SteamVR a standing 2 x 2 m room at each start, so no Room Setup is "
                  "needed (SteamVR's Room Setup sets your own).", fix if getattr(opts, "cmd", None) == "repair" else None,
                  "user" if getattr(opts, "cmd", None) == "repair" else None)


def direct_mode_state(p):
    """(the driver's manifest lets it drive the display, settings.json's display.direct_mode). The setting is on
    unless it says false, as the driver reads it; the package's manifest always says yes, off is the setting alone."""
    m = read_json(p.manifest) or {}
    s = read_json(p.settings)
    s = s if isinstance(s, dict) else {}
    v = s.get("display", {}).get("direct_mode")
    return bool(m.get("redirectsDisplay")), v is not False and v != 0


def set_direct_mode(p, on):
    """Direct mode on or off from SteamVR's next start: settings.json only. A driver folder of its own (a development
    build, not the package's copy) whose manifest does not let it drive the display gets that too when turned on."""
    s = load_settings(p)
    s.setdefault("display", {})["direct_mode"] = on
    write_json(p.settings, s)
    m = read_json(p.manifest) or {}
    managed = os.path.exists(os.path.join(os.path.dirname(p.manifest), ".riftlinux-managed"))
    if on and not m.get("redirectsDisplay") and not managed and os.path.exists(p.manifest):
        m["redirectsDisplay"] = True
        write_json(p.manifest, m)


def check_settings(p, opts):
    try:
        s = load_settings(p) if os.path.exists(p.settings) else None
    except BadSettings as e:
        known, when = last_known(p)
        return result("settings", "RiftLinux settings", "error",
                      f"{e}: nothing is saved into it, and "
                      + (f"the last good settings (from {when}) are used; fix it by hand, or put them back with "
                         "riftlinux-setup fix last-known." if known is not None else
                         "every RiftLinux setting is at its default; fix it by hand, or start over with riftlinux-setup "
                         "fix last-known (the file is kept)."))
    want = getattr(opts, "direct_mode", None)
    man, sett = direct_mode_state(p) if os.path.exists(p.manifest) else (False, False)
    if s is None and want not in ("on", "off"):
        return result("settings", "RiftLinux settings", "ok",
                      "No settings yet: the defaults (notices on, direct mode on, SteamVR starts when the Rift is put "
                      "on, Steam's menu closes once a game shows); the Rift tab writes them.")
    if sett and not man:
        return result("settings", "RiftLinux settings", "warn",
                      f"Direct mode is on in the settings, but the driver's manifest ({p.manifest}) does not let it drive "
                      "the display: reinstall the package (or `riftlinux-setup direct-mode on` for a driver folder of "
                      "your own).")
    if want in ("on", "off") and (want == "on") != sett:
        return result("settings", "RiftLinux settings", "fix", f"Direct mode {want}.", lambda: set_direct_mode(p, want == "on"),
                      "user")
    problems = settings_problems(s or {})
    return result("settings", "RiftLinux settings", "warn" if problems else "ok",
                  ("; ".join(problems) + ". " if problems else "") +
                  f"Direct mode {'on' if sett else 'off'}; SteamVR starts by itself: "
                  f"{autostart_text(s or {}) if autostart_on(s or {}) else 'off (riftlinux-setup autostart on)'}; "
                  f"Steam's menu over a "
                  f"starting game: {'closed' if game_menu_closed(s or {}) else 'kept (riftlinux-setup game-menu close)'}"
                  f"; SteamVR's standby ends when the headset "
                  f"{'moves or is worn' if standby_by_pick_up(s or {}) else 'is worn'}"
                  f"; controllers sleep: "
                  f"{'never' if controller_sleep_min(s or {}) is None else str(controller_sleep_min(s or {})) + ' min'}"
                  f" after the headset is off; headset taken off: {not_worn_text(headset_settings(s or {}))}"
                  f"; {motion_text(headset_settings(s or {}))}"
                  f"; {p.settings}.")


def check_display(p, opts):
    found = []
    base = "/sys/class/drm"
    try:
        names = os.listdir(base)
    except OSError:
        names = []
    for n in sorted(names):
        try:
            with open(os.path.join(base, n, "edid"), "rb") as f:
                e = f.read()
        except OSError:
            continue
        if len(e) < 10:
            continue
        v = (e[8] << 8) | e[9]
        pnp = "".join(chr(((v >> s) & 31) + 64) for s in (10, 5, 0))
        if pnp == "OVR":
            found.append((n, sysfs(os.path.join(base, n), "status")))
    # Only what the X server reads: xorg.conf and *.conf in its conf.d directories; commented lines do not count.
    allow_hmd = []
    files = ["/etc/X11/xorg.conf"]
    for d in ("/etc/X11/xorg.conf.d", "/usr/share/X11/xorg.conf.d"):
        try:
            files += [os.path.join(d, f) for f in sorted(os.listdir(d)) if f.endswith(".conf")]
        except OSError:
            pass
    for path in files:
        try:
            lines = open(path, errors="replace").read().lower().splitlines()
        except OSError:
            continue
        if any("allowhmd" in l.split("#")[0] and "yes" in l.split("#")[0] for l in lines):
            allow_hmd.append(path)
    if allow_hmd:
        return result("display", "Headset display", "warn",
                      "An X configuration allows the headset as a desktop monitor (AllowHMD): " + ", ".join(allow_hmd) +
                      ". The desktop then takes the headset and SteamVR cannot drive it; move that file away (root).")
    if not found:
        if any(d["product"] == "0031" for d in usb_devices()):
            return result("display", "Headset display", "info",
                          "Not visible from here: the CV1 is on HDMI only while its display is on (SteamVR running and "
                          "the headset worn), and NVIDIA's driver does not show its EDID to this check. SteamVR's log says "
                          "whether it found it.")
        return result("display", "Headset display", "warn", "The headset is not seen on HDMI (cable, or the GPU's HDMI port).")
    session = desktop_session_type() or "?"
    return result("display", "Headset display", "ok", f"On {found[0][0]} ({found[0][1]}); desktop session: {session}.")


def steam_process():
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if open(f"/proc/{pid}/comm").read().strip() == "steam" and os.stat(f"/proc/{pid}").st_uid == os.getuid():
                return int(pid)
        except OSError:
            continue
    return None


def check_realtime(p, opts):
    # Its D-Bus service file, where every distribution puts it; the daemon itself lives in different places
    # (/usr/libexec on Debian and Fedora, /usr/lib on Arch).
    rtkit = os.path.exists("/usr/share/dbus-1/system-services/org.freedesktop.RealtimeKit1.service") or any(
        os.path.exists(d) for d in ("/usr/libexec/rtkit-daemon", "/usr/lib/rtkit-daemon", "/usr/lib/rtkit/rtkit-daemon")
    ) or shutil.which("rtkit-daemon")
    if not rtkit:
        return result("realtime", "Real-time priority", "warn",
                      "RealtimeKit (rtkit) is not installed: the Rift's threads will run at normal priority. "
                      "Install the distribution's rtkit package.")
    pid = steam_process()
    if pid is None:
        return result("realtime", "Real-time priority", "ok", "RealtimeKit present (checked again when Steam runs).")
    pk = shutil.which("pkcheck")
    if pk:
        r = run([pk, "--action-id", "org.freedesktop.RealtimeKit1.acquire-real-time", "--process", str(pid)])
        if r is not None and r.returncode != 0:
            return result("realtime", "Real-time priority", "warn",
                          f"Steam (pid {pid}) may not get real-time priority: it was not started from your desktop "
                          "session (for example from an SSH login). Quit Steam and start it from the desktop.")
    return result("realtime", "Real-time priority", "ok", f"RealtimeKit present; Steam (pid {pid}) may use it.")


def check_calibration(p, opts):
    if os.path.exists(p.rig):
        return result("calibration", "Sensor calibration", "ok", f"Saved ({p.rig}); a moved sensor is found and placed again.")
    return result("calibration", "Sensor calibration", "info",
                  "None saved yet: at the first start move the headset slowly in view of the sensors for a few "
                  "seconds; it is saved by itself.")


NATIVE_DIR = "/usr/lib/riftlinux/native"


def x86_64():
    import platform
    return platform.machine() in ("x86_64", "AMD64")


def check_arch(p, opts):
    import platform
    if x86_64():
        return result("arch", "Computer", "ok", "x86-64")
    return result("arch", "Computer", "error",
                  f"{platform.machine()}: the SteamVR driver and the own runtime are built for x86-64 (64-bit Intel "
                  "and AMD) computers only; on this one only `riftlinux-setup check` and `riftlinux-setup pair` work.")


def native_dir(p):
    if os.path.exists(os.path.join(NATIVE_DIR, "monado-service")):
        return NATIVE_DIR
    return os.path.join(os.path.dirname(os.path.realpath(p.package)), "rift-cv1-native")


def check_native(p, opts):
    title = "Own runtime (OpenXR without SteamVR)"
    d = native_dir(p)
    files = [os.path.join(d, "monado-service"), os.path.join(d, "libopenxr_monado.so")]
    if not all(os.path.exists(f) for f in files):
        return result("native", title, "info", "not installed (SteamVR does not need it)")
    if not x86_64():
        return result("native", title, "info", "built for x86-64, not this computer")
    r = run(["ldd"] + files)
    if r is None:
        return result("native", title, "info", f"{d}; libraries not checked (no ldd)")
    missing = sorted({line.split()[0] for line in r.stdout.splitlines() if "not found" in line})
    if missing:
        return result("native", title, "warn", "libraries missing: " + ", ".join(missing) + " (install your "
                      "distribution's packages for them; SteamVR is not affected)")
    return result("native", title, "ok", f"{d}, every library found; start it with `riftlinux-runtime`")


# --------------------------------------------------------------------------------------------------------------------
# What other setups leave behind that keeps games or the headset from SteamVR and this driver: variables that point
# games at another runtime, the same in games' launch options, SteamVR itself forced onto Proton, programs still
# holding the Rift's devices, a headset left in pairing mode.

# Variables that take games or SteamVR elsewhere, and what they do then.
ENV_OVERRIDES = {
    "XR_RUNTIME_JSON": "OpenXR games use the runtime it names instead of SteamVR",
    "VR_OVERRIDE": "OpenVR games load the runtime it names instead of SteamVR",
    "VR_CONFIG_PATH": "SteamVR and games read their settings from another folder",
    "VR_LOG_PATH": "SteamVR and games log to another folder",
}
# STEAM_RUNTIME=0 runs Steam's programs outside its runtime: SteamVR then misses libraries it brings.
ENV_ONLY_IF = {"STEAM_RUNTIME": "0"}
ENV_FILES = ["~/.config/environment.d/*.conf", "~/.profile", "~/.bash_profile", "~/.bash_login", "~/.bashrc",
             "~/.zshenv", "~/.zprofile", "~/.zshrc", "~/.config/fish/config.fish", "~/.config/fish/conf.d/*.fish",
             "~/.pam_environment", "~/.config/plasma-workspace/env/*.sh", "~/.xprofile", "~/.xsessionrc"]
SYSTEM_ENV_FILES = ["/etc/environment", "/etc/environment.d/*.conf", "/etc/profile.d/*.sh"]


def env_names():
    return list(ENV_OVERRIDES) + list(ENV_ONLY_IF)


def env_line_sets(line):
    """The variable an environment or shell file's line sets, if one of ours (export X=, X=, set -gx X, setenv X)."""
    s = line.strip()
    if s.startswith("#"):
        return None
    for prefix in ("export ", "set -gx ", "set -x ", "setenv "):
        if s.startswith(prefix):
            s = s[len(prefix):].lstrip()
            break
    for name in env_names():
        if s.startswith(name + "=") or s.startswith(name + " ") or s.startswith(name + "\t"):
            value = s[len(name):].lstrip("= \t").strip("'\"")
            if name in ENV_ONLY_IF and value != ENV_ONLY_IF[name]:
                return None
            return name
    return None


def process_env(pid):
    try:
        raw = open(f"/proc/{pid}/environ", "rb").read()
    except OSError:
        return {}
    env = {}
    for item in raw.split(b"\0"):
        if b"=" in item:
            k, v = item.split(b"=", 1)
            env[k.decode(errors="replace")] = v.decode(errors="replace")
    return env


def check_env_overrides(p, opts):
    title = "Variables that take games elsewhere"
    pid = steam_process()
    steam_env = process_env(pid) if pid else {}
    live = [f"{k}={steam_env[k]}" for k in env_names() if k in steam_env and
            (k not in ENV_ONLY_IF or steam_env[k] == ENV_ONLY_IF[k])]
    files = []
    for pattern in ENV_FILES:
        for path in sorted(glob.glob(os.path.expanduser(pattern))):
            try:
                lines = open(path, errors="replace").read().splitlines()
            except OSError:
                continue
            hits = [(i, env_line_sets(l)) for i, l in enumerate(lines)]
            hits = [(i, name) for i, name in hits if name]
            if hits:
                files.append((path, hits))
    system = []
    for pattern in SYSTEM_ENV_FILES:
        for path in sorted(glob.glob(pattern)):
            try:
                if any(env_line_sets(l) for l in open(path, errors="replace")):
                    system.append(path)
            except OSError:
                pass
    if not live and not files and not system:
        return result("env", title, "ok", "None set (XR_RUNTIME_JSON, VR_OVERRIDE, VR_CONFIG_PATH, VR_LOG_PATH).")
    detail = []
    if live:
        detail.append("Steam runs with " + ", ".join(live) + " (" +
                      "; ".join(ENV_OVERRIDES.get(v.split("=")[0], "Steam's programs run outside its runtime")
                                for v in live) + ")")
    for path, hits in files:
        detail.append(f"{path} sets " + ", ".join(sorted({n for _, n in hits})))
    if system:
        detail.append("system files set them too (root, remove by hand): " + ", ".join(system))
    if live and not files and not system:
        detail.append("set by how Steam was started (a launcher, script or desktop entry): start it from the "
                      "desktop's own Steam entry")

    def fix():
        for path, hits in files:
            lines = open(path, errors="replace").read().splitlines(keepends=True)
            for i, _ in hits:
                lines[i] = "# (riftlinux-setup) " + lines[i]
            write_text(path, "".join(lines))

    if not files:
        return result("env", title, "warn", "; ".join(detail) + ".")
    return result("env", title, "fix", "; ".join(detail) + ". Their lines in your files will be commented out "
                  "(log out and back in afterwards).", fix, "user")


def steam_config_vdf(p):
    for root in p.steam_roots():
        path = os.path.join(root, "config", "config.vdf")
        if os.path.exists(path):
            return path
    return None


def localconfig_files(p):
    found = []
    for root in p.steam_roots():
        found += glob.glob(os.path.join(root, "userdata", "*", "config", "localconfig.vdf"))
    seen, out = set(), []
    for f in found:
        if os.path.realpath(f) not in seen:
            seen.add(os.path.realpath(f))
            out.append(f)
    return out


def strip_overrides(options):
    """Launch options without the variables of ENV_OVERRIDES (NAME=value, NAME="a b"), the rest as it was."""
    import re
    pattern = r'(?<![\w])(?:' + "|".join(ENV_OVERRIDES) + r')=(?:"[^"]*"|\'[^\']*\'|\S*)\s*'
    return re.sub(pattern, "", options).strip()


def check_launch_options(p, opts):
    title = "Games' launch options"
    found = []
    for path in localconfig_files(p):
        try:
            d = vdf_load(open(path, errors="replace").read())
        except (OSError, RecursionError):
            continue
        apps = vdf_get(d, "UserLocalConfigStore", "Software", "Valve", "Steam", "apps") or {}
        for app_id, app in apps.items():
            options = app.get("LaunchOptions") if isinstance(app, dict) else None
            if options and strip_overrides(options) != options.strip():
                found.append((path, app_id, options))
    if not found:
        return result("launchopts", title, "ok", "None point games at another VR runtime.")
    names = ", ".join(sorted({f"app {a} ({o})" for _, a, o in found}))
    detail = f"{names}: those variables take the game away from SteamVR"
    if steam_process():
        return result("launchopts", title, "warn", detail + ". Close Steam and run this again to change them (Steam "
                      "writes its settings back as it quits).")

    def fix():
        for path in sorted({f for f, _, _ in found}):
            d = vdf_load(open(path, errors="replace").read())
            apps = vdf_get(d, "UserLocalConfigStore", "Software", "Valve", "Steam", "apps") or {}
            for app_id, app in apps.items():
                if isinstance(app, dict) and app.get("LaunchOptions"):
                    app["LaunchOptions"] = strip_overrides(app["LaunchOptions"])
            write_text(path, vdf_dump(d))

    return result("launchopts", title, "fix", detail + "; they will be removed from the launch options (the rest "
                  "stays).", fix, "user")


def check_steamvr_tool(p, opts):
    """SteamVR is a Linux program run in Steam's own runtime: a compatibility tool forced on it (Proton) runs the
    Windows SteamVR instead, which has no Linux drivers."""
    title = "SteamVR's compatibility tool"
    path = steam_config_vdf(p)
    mapping = None
    if path:
        try:
            d = vdf_load(open(path, errors="replace").read())
            mapping = vdf_get(d, "InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping", "250820")
        except (OSError, RecursionError):
            mapping = None
    tool = (mapping or {}).get("name") if isinstance(mapping, dict) else None
    if not tool:
        return result("steamvr-tool", title, "ok", "None forced (SteamVR runs as a Linux program).")
    detail = (f"Steam is told to run SteamVR with \"{tool}\" (SteamVR, Properties, Compatibility), which runs the "
              "Windows SteamVR without this driver")
    if steam_process():
        return result("steamvr-tool", title, "warn", detail + ". Close Steam and run this again, or untick it there.")

    def fix():
        d2 = vdf_load(open(path, errors="replace").read())
        m2 = vdf_get(d2, "InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping") or {}
        for k in [k for k in m2 if k == "250820"]:
            del m2[k]
        write_text(path, vdf_dump(d2))

    return result("steamvr-tool", title, "fix", detail + "; it will be removed.", fix, "user")


# Programs that may hold the Rift's devices: SteamVR and RiftLinux's own runtime while they run, and Steam (the
# watchdog that starts SteamVR reads the headset). Other VR services left running keep the devices from the driver.
OTHER_VR_SERVICES = {"monado-service": "Monado", "wivrn-server": "WiVRn", "ouvrtd": "ouvrt", "ouvrt": "ouvrt",
                     "alvr_dashboard": "ALVR", "envision": "Envision", "survive-cli": "libsurvive"}


def rift_nodes():
    nodes = {h["node"] for h in hidraw_nodes()} | {d["node"] for d in usb_devices() if d["node"]}
    try:
        for n in os.listdir("/sys/class/video4linux"):
            d = os.path.realpath(os.path.join("/sys/class/video4linux", n, "device"))
            while d and d != "/":
                if sysfs(d, "idVendor") == VENDOR:
                    nodes.add("/dev/" + n)
                    break
                d = os.path.dirname(d)
    except OSError:
        pass
    return nodes


def rift_holders():
    """(pid, name, exe, nodes) for this user's processes with the Rift's devices open, but SteamVR, Steam and this
    package's own programs."""
    nodes = rift_nodes()
    out = []
    if not nodes:
        return out
    uid = os.getuid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid:
                continue
            comm = open(f"/proc/{pid}/comm").read().strip()
            exe = os.path.realpath(f"/proc/{pid}/exe")
            held = set()
            for fd in os.listdir(f"/proc/{pid}/fd"):
                try:
                    target = os.readlink(f"/proc/{pid}/fd/{fd}")
                except OSError:
                    continue
                if target in nodes:
                    held.add(target)
        except OSError:
            continue
        if not held:
            continue
        ours = "/riftlinux/" in exe or exe.startswith(NATIVE_DIR) or os.path.basename(exe).startswith("riftlinux")
        if comm in ("steam", "vrserver", "vrcompositor") or "/SteamVR/" in exe or ours:
            continue
        out.append((int(pid), comm, exe, sorted(held)))
    return out


def check_holders(p, opts):
    title = "Other programs using the Rift"
    holders = rift_holders()
    if not holders:
        return result("holders", title, "ok", "None (only SteamVR, Steam and RiftLinux use it).")
    services = [h for h in holders if h[1] in OTHER_VR_SERVICES]
    others = [h for h in holders if h[1] not in OTHER_VR_SERVICES]
    detail = "; ".join(f"{OTHER_VR_SERVICES.get(c, c)} ({c}, pid {pid}) has {', '.join(n)} open"
                       for pid, c, _, n in holders)
    if others:
        detail += "; close the programs named above (a camera app can hold a sensor)"

    def fix():
        import signal
        import time
        for pid, _, _, _ in services:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        time.sleep(2.0)

    if services:
        return result("holders", title, "fix", detail + ". The other VR services will be stopped.", fix, "user")
    return result("holders", title, "warn", detail + ".")


def check_headset_mode(p, opts):
    """A headset restarted into the radio's pairing mode (an interrupted pairing) reports no tracking until it is
    restarted into normal mode; SteamVR then sees a headset that never moves."""
    title = "Headset mode"
    if not any(d["product"] == "0031" for d in usb_devices()):
        return result("headset", title, "info", "Plug in the Rift to check.")
    node = cv1_hidraw(0)
    if node is None:
        return result("headset", title, "error",
                      "The headset is on USB but the kernel made no HID interface for it (its HID driver usbhid is "
                      "not bound: blacklisted, or claimed by another driver). Unplug it and plug it in again; if that "
                      "does not help, `dmesg | grep -i 2833` says why.")
    if busy_runtime():
        return result("headset", title, "info", "In use by SteamVR or the runtime now (checked when they are closed).")
    try:
        fd = os.open(node, os.O_RDWR)
    except OSError as e:
        return result("headset", title, "info", f"{node} not opened ({e.strerror}): see Device access.")
    try:
        mode = boot_mode(fd)
    except OSError:
        os.close(fd)
        return result("headset", title, "info", "Its mode could not be read.")
    if mode == 0:
        os.close(fd)
        return result("headset", title, "ok", "Normal (not in pairing mode).")

    def fix():
        restart_headset(os.open(node, os.O_RDWR), 0)

    os.close(fd)
    return result("headset", title, "fix", f"Left in pairing mode (boot mode {mode}), so it reports no tracking; it "
                  "will be restarted into normal mode.", fix, "user")


