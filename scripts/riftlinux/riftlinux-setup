def cmd_autostart(p, opts):
    """settings.json steamvr.start_when_put_on, start_on_pick_up, quit_if_not_put_on: the driver's watchdog in Steam
    starts SteamVR when the Rift is put on or picked up (it reads them every second); a SteamVR a pick-up started
    quits again when the Rift is not put on (read at SteamVR's start)."""
    s = load_settings(p)
    if opts.mode == "status":
        print(f"SteamVR starts by itself: {autostart_text(s)}")
        return 0
    want = {"trigger": ("put-on", "pick-up"), "quit-unused": ("on", "off")}.get(opts.mode)
    if want and opts.value not in want:
        print(f"riftlinux-setup autostart {opts.mode} {'|'.join(want)}")
        return 2
    steamvr = s.get("steamvr") if isinstance(s.get("steamvr"), dict) else {}
    if opts.mode == "trigger":
        if opts.value == "pick-up":
            steamvr.pop("start_on_pick_up", None)
        else:
            steamvr["start_on_pick_up"] = False
    elif opts.mode == "quit-unused":
        if opts.value == "on":
            steamvr.pop("quit_if_not_put_on", None)
        else:
            steamvr["quit_if_not_put_on"] = False
    elif opts.mode == "on":
        steamvr.pop("start_when_put_on", None)
    else:
        steamvr["start_when_put_on"] = False
    if steamvr:
        s["steamvr"] = steamvr
    else:
        s.pop("steamvr", None)
    write_json(p.settings, s)
    if opts.mode == "trigger":
        print("Putting the Rift on starts SteamVR; picking it up does not." if opts.value == "put-on" else
              "Putting the Rift on or picking it up starts SteamVR.")
        if opts.value == "put-on" and (s.get("headset") or {}).get("wear_sensor") is False:
            print("The wear sensor is off (riftlinux-setup wear-sensor on): until it is on, picking the Rift up still "
                  "starts SteamVR.")
    elif opts.mode == "quit-unused":
        print("A SteamVR started by picking the Rift up quits again when it is not put on (from SteamVR's next start)."
              if opts.value == "on" else
              "A SteamVR started by picking the Rift up runs on until you quit it (from SteamVR's next start).")
    elif opts.mode == "on":
        print("On: Steam starts SteamVR when the Rift is put on or picked up (while Steam runs).")
    else:
        print("Off: SteamVR starts only when you start it or a game; RiftLinux's own runtime can use the headset "
              "without SteamVR starting.")
    return 0


