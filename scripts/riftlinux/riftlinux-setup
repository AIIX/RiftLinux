# Checks. Each returns a dict: id, title, state (ok, info, warn, fix, error), detail, and optionally fix (a callable
# applying it, with kind "user" or "root") and root_cmds.


def result(cid, title, state, detail, fix=None, kind=None, root_cmds=None):
    return {"id": cid, "title": title, "state": state, "detail": detail, "fix": fix, "kind": kind,
            "root_cmds": root_cmds or []}


def check_steam(p, opts):
    roots = p.steam_roots()
    if not roots:
        return result("steam", "Steam", "error", "No Steam installation found (~/.steam, ~/.local/share/Steam, Flatpak).")
    if p.steamvr is None:
        return result("steam", "Steam and SteamVR", "error",
                      f"Steam at {roots[0]}, but SteamVR is not installed: install it from Steam's library (Tools).")
    ver = None
    vfile = os.path.join(p.steamvr, "bin", "version.txt")
    try:
        ver = open(vfile).read().strip().splitlines()[0]
    except (OSError, IndexError):
        pass
    if not os.path.exists(p.openvrpaths):
        return result("steam", "Steam and SteamVR", "error",
                      f"SteamVR at {p.steamvr} has never been started: start it once from Steam, then run this again.")
    return result("steam", "Steam and SteamVR", "ok", f"SteamVR (build {ver}) at {p.steamvr}" if ver else f"SteamVR at {p.steamvr}")


def check_package(p, opts):
    if not os.path.exists(p.manifest) or not os.path.exists(p.driver_so):
        return result("package", "Driver package", "error",
                      f"{p.package} has no driver.vrdrivermanifest and bin/linux64/driver_monado.so: "
                      "run this tool from the unpacked package or pass --package.")
    return result("package", "Driver package", "ok", p.package)


def check_registered(p, opts):
    vp = read_json(p.openvrpaths)
    if vp is None:
        return result("registered", "Driver registered with SteamVR", "error", "No openvrpaths.vrpath (start SteamVR once).")
    drivers = vp.get("external_drivers", []) or []
    mine = [d for d in drivers if os.path.realpath(d) == os.path.realpath(p.package)]
    others = []
    for d in drivers:
        if os.path.realpath(d) == os.path.realpath(p.package):
            continue
        m = read_json(os.path.join(d, "driver.vrdrivermanifest")) or {}
        if m.get("name") == DRIVER_NAME:
            others.append(d)

    def fix():
        vp2 = read_json(p.openvrpaths)
        ext = [d for d in vp2.get("external_drivers", []) or [] if d not in others]
        if not any(os.path.realpath(d) == os.path.realpath(p.package) for d in ext):
            ext.append(p.package)
        vp2["external_drivers"] = ext
        write_json(p.openvrpaths, vp2)

    if mine and not others:
        return result("registered", "Driver registered with SteamVR", "ok", p.package)
    detail = []
    if not mine:
        detail.append(f"{p.package} is not registered")
    if others:
        detail.append("another driver named \"monado\" is registered too (only one can load): " + ", ".join(others) +
                      "; it will be unregistered (its files stay)")
    return result("registered", "Driver registered with SteamVR", "fix", "; ".join(detail) + ".", fix, "user")


# Other headset drivers SteamVR may use for the headset instead of this one, left registered by another CV1 setup or a
# streaming one: SteamVR-OpenHMD claims every system ("hmd_presence": ["*.*"]). Games then render to that driver's
# headset and never reach this one. Only SteamVR's list (or its add-on switch) is changed; their files stay.
OTHER_HMD_DRIVERS = {"openhmd": "SteamVR-OpenHMD", "alvr_server": "ALVR"}
# SteamVR's own drivers (its drivers/ folder); one copied in next to them by a guide is switched off instead.
VALVE_DRIVERS = {"frame_controller", "frame_hmd", "gamepad", "htc", "indexcontroller", "indexhmd", "lighthouse",
                 "null", "oculus", "oculus_legacy", "prism", "tundra_labs", "vrlink"}


def claims_rift(manifest):
    """A driver manifest that offers a headset for this system: every system ("*.*") or Oculus' USB ids (2833)."""
    presence = manifest.get("hmd_presence") or []
    return any(str(e) == "*.*" or str(e).lower().startswith("2833") for e in presence)


def steamvr_folder_drivers(p):
    """Third-party headset drivers inside SteamVR's own drivers folder: (name, folder)."""
    out = []
    base = os.path.join(p.steamvr, "drivers") if p.steamvr else None
    try:
        names = sorted(os.listdir(base)) if base else []
    except OSError:
        names = []
    for n in names:
        m = read_json(os.path.join(base, n, "driver.vrdrivermanifest")) or {}
        name = m.get("name") or n
        if n not in VALVE_DRIVERS and name not in VALVE_DRIVERS and name != DRIVER_NAME and claims_rift(m):
            out.append((name, os.path.join(base, n)))
    return out


def steamvr_busy():
    return busy_runtime() in ("vrserver", "vrcompositor")


def check_other_drivers(p, opts):
    vp = read_json(p.openvrpaths) or {}
    others = []
    for d in vp.get("external_drivers", []) or []:
        if os.path.realpath(d) == os.path.realpath(p.package):
            continue
        m = read_json(os.path.join(d, "driver.vrdrivermanifest")) or {}
        name = m.get("name")
        if name in OTHER_HMD_DRIVERS or (name != DRIVER_NAME and claims_rift(m)):
            others.append((d, OTHER_HMD_DRIVERS.get(name, name or os.path.basename(d))))
    vs = (read_json(p.vrsettings) or {}) if p.vrsettings else {}
    forced = (vs.get("steamvr") or {}).get("forcedDriver")
    forced_other = bool(forced) and forced != DRIVER_NAME
    in_folder = [(n, d) for n, d in steamvr_folder_drivers(p) if (vs.get("driver_" + n) or {}).get("enable") is not False]
    null_on = (vs.get("driver_null") or {}).get("enable") is True
    title = "Other headset drivers in SteamVR"
    if not others and not forced_other and not in_folder and not null_on:
        return result("others", title, "ok", "None: SteamVR uses this driver for the headset.")

    detail = []
    if others:
        detail.append("registered too: " + ", ".join(f"{name} ({d})" for d, name in others) +
                      "; SteamVR can use its headset instead of this one, and games then don't reach the Rift")
    if in_folder:
        detail.append("in SteamVR's own drivers folder: " + ", ".join(f"{n} ({d})" for n, d in in_folder) +
                      ", offering a headset too")
    if null_on:
        detail.append("SteamVR's test headset (the null driver) is switched on")
    if forced_other:
        detail.append(f"SteamVR's settings force the driver \"{forced}\" for the headset (steamvr.forcedDriver)")
    if steamvr_busy():
        return result("others", title, "warn", "; ".join(detail) + ". Close SteamVR and run this again to change it.")

    def fix():
        if others:
            vp2 = read_json(p.openvrpaths) or {}
            gone = {d for d, _ in others}
            vp2["external_drivers"] = [d for d in vp2.get("external_drivers", []) or [] if d not in gone]
            write_json(p.openvrpaths, vp2)
        if forced_other or in_folder or null_on:
            vs2 = read_json(p.vrsettings) or {}
            if forced_other:
                (vs2.get("steamvr") or {}).pop("forcedDriver", None)
            for n, _ in in_folder:
                vs2.setdefault("driver_" + n, {})["enable"] = False
            if null_on:
                vs2.setdefault("driver_null", {})["enable"] = False
            write_json(p.vrsettings, vs2, indent=3)

    what = []
    if others:
        what.append("unregistered (their files stay)")
    if in_folder or null_on:
        what.append("switched off in SteamVR's add-ons (their files stay)")
    if forced_other:
        what.append("the forced driver setting removed")
    return result("others", title, "fix", "; ".join(detail) + ". They will be " + " and ".join(what) + ".", fix, "user")


# SteamVR settings that keep games from SteamVR when changed from SteamVR's defaults (an earlier headset, a guide,
# a tool): steamvr.forcedHmd names another headset, which SteamVR then waits for; requireHmd false lets SteamVR start
# a session without the Rift; startCompositorFromAppLaunch false gives a game that starts SteamVR no compositor (a dark
# headset); startMonitorFromAppLaunch and startDashboardFromAppLaunch false leave SteamVR without its window and menu.
LAUNCH_DEFAULTS = {"requireHmd": True, "startCompositorFromAppLaunch": True, "startMonitorFromAppLaunch": True,
                   "startDashboardFromAppLaunch": True}


def check_steamvr_launch(p, opts):
    title = "SteamVR settings games depend on"
    vs = (read_json(p.vrsettings) or {}) if p.vrsettings else {}
    steamvr = vs.get("steamvr") or {}
    force = getattr(opts, "force", False)
    changed = []
    if steamvr.get("forcedHmd"):
        changed.append(f"steamvr.forcedHmd is \"{steamvr['forcedHmd']}\" (SteamVR waits for that headset)")
    for key, default in LAUNCH_DEFAULTS.items():
        if key in steamvr and steamvr[key] != default:
            changed.append(f"steamvr.{key} is {json.dumps(steamvr[key])} (SteamVR's default: {json.dumps(default)})")
    # SteamVR's own direct display mode, which its compositor needs when this driver's direct mode is off.
    direct_off = (vs.get("direct_mode") or {}).get("enable") is False
    if direct_off:
        changed.append("SteamVR's Direct Display Mode is off (its compositor then shows the headset as a desktop "
                       "monitor when this driver's direct mode is off)")
    # SteamVR 2.18 starts without SteamVR Home unless switched on; the tested setup has it on.
    home_off = force and steamvr.get("enableHomeApp") is False
    if home_off:
        changed.append("SteamVR Home is switched off (steamvr.enableHomeApp)")
    if not changed:
        return result("launch", title, "ok", "SteamVR's defaults (no forced headset, a compositor for games).")
    if steamvr_busy():
        return result("launch", title, "warn", "; ".join(changed) + ". Close SteamVR and run this again to change it.")

    def fix():
        vs2 = read_json(p.vrsettings) or {}
        section = vs2.get("steamvr") or {}
        section.pop("forcedHmd", None)
        for key in LAUNCH_DEFAULTS:
            section.pop(key, None)
        if home_off:
            section["enableHomeApp"] = True
        vs2["steamvr"] = section
        if direct_off:
            (vs2.get("direct_mode") or {}).pop("enable", None)
        write_json(p.vrsettings, vs2, indent=3)

    return result("launch", title, "fix", "; ".join(changed) + ". They will be set back to SteamVR's defaults.", fix,
                  "user")


# GPU fence handles (sync_file) a desktop session leaked: GNOME Shell 48 on NVIDIA was seen holding 125000 of them
# after screen recordings, without close-on-exec, so every program started from the desktop (Steam, and SteamVR from
# it) gets a copy; SteamVR Home then could not open any more files and crashed. Only logging out clears them.
LEAKED_HANDLES_WARN = 10000


def count_sync_files(pid):
    n = 0
    try:
        fds = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return 0
    for fd in fds:
        try:
            if os.readlink(f"/proc/{pid}/fd/{fd}") == "anon_inode:sync_file":
                n += 1
        except OSError:
            pass
    return n


def check_leaked_handles(p, opts):
    title = "Leaked GPU handles in the desktop session"
    names = {"steam", "gnome-shell", "kwin_wayland", "kwin_x11", "Xwayland", "plasmashell"}
    uid = os.getuid()
    leaky = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid:
                continue
            comm = open(f"/proc/{pid}/comm").read().strip()
        except OSError:
            continue
        if comm in names:
            n = count_sync_files(pid)
            if n >= LEAKED_HANDLES_WARN:
                leaky.append(f"{comm} {n}")
    if not leaky:
        return result("handles", title, "ok", "None found (Steam and the desktop shell).")
    return result("handles", title, "warn",
                  "Holding leaked GPU fence handles: " + ", ".join(leaky) + ". Every program started from this "
                  "desktop gets a copy of them, and SteamVR Home or games can then fail to open files or crash. Log "
                  "out and back in (or restart) before playing. Seen with GNOME on NVIDIA after screen recordings.")


# Steam loads the driver's watchdog (bin/linux32, what starts SteamVR when the Rift is put on) as it starts and keeps
# it until it quits: after an update it still runs the one from before (its file replaced, "(deleted)" in Steam's
# memory map, another inode) until Steam is restarted, and the update's watchdog changes are not there yet.
def check_watchdog_loaded(p, opts):
    title = "SteamVR start watchdog in Steam"
    current = os.path.join(p.package, "bin", "linux32", "driver_monado.so")
    try:
        inode = os.stat(current).st_ino
    except OSError:
        return result("watchdog", title, "info", "This driver package has no watchdog (bin/linux32).")
    uid = os.getuid()
    loaded = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid or open(f"/proc/{pid}/comm").read().strip() != "steam":
                continue
            maps = open(f"/proc/{pid}/maps").read().splitlines()
        except OSError:
            continue
        for line in maps:
            if "/bin/linux32/driver_monado.so" in line:
                fields = line.split()
                loaded.append((fields[4], line.endswith("(deleted)")))
                break
    if not loaded:
        return result("watchdog", title, "info", "Not loaded now (Steam is not running, SteamVR runs, or Steam has "
                      "not loaded it yet: it does as it starts and after SteamVR quits).")
    if any(deleted or str(ino) != str(inode) for ino, deleted in loaded):
        return result("watchdog", title, "warn", "Steam still runs the watchdog from before the update: restart "
                      "Steam (Steam menu, Exit, then start it again) to load the new one.")
    return result("watchdog", title, "ok", "Steam runs this package's watchdog.")


# The OpenVR runtime Steam's games load: the first entry of openvrpaths.vrpath's runtime list. Another one there
# (WiVRn's xrizer, OpenComposite, left by an earlier setup) takes the games away from SteamVR while SteamVR itself and
# OpenXR programs still work.
def check_openvr_runtime(p, opts):
    title = "OpenVR runtime (what Steam's games load)"
    vp = read_json(p.openvrpaths) or {}
    runtimes = [r for r in vp.get("runtime", []) or [] if os.path.isdir(r)]
    if not p.steamvr:
        return result("openvr", title, "info", "SteamVR not found.")
    if runtimes and os.path.realpath(runtimes[0]) == p.steamvr:
        return result("openvr", title, "ok", "SteamVR.")
    first = runtimes[0] if runtimes else None
    detail = (f"{first} comes first, so OpenVR games load it instead of SteamVR and don't reach the Rift" if first
              else "none set")
    if steamvr_busy():
        return result("openvr", title, "warn", detail + ". Close SteamVR and run this again to change it.")

    def fix():
        vp2 = read_json(p.openvrpaths) or {}
        rest = [r for r in vp2.get("runtime", []) or [] if os.path.realpath(r) != p.steamvr]
        vp2["runtime"] = [p.steamvr] + rest
        write_json(p.openvrpaths, vp2)

    return result("openvr", title, "fix", detail + "; SteamVR will be put first (the others stay listed).", fix, "user")


def check_sandboxed(p, opts):
    """Flatpak or Snap Steam: its SteamVR reads only its own directories, so it needs its own copy, in its own list."""
    missing = []
    present = []
    for name, config_dir, data_dir, _ in steam_installs()[1:]:
        present.append(name)
        dst = user_copy_dir(data_dir)
        vp = read_json(os.path.join(config_dir, "openvr", "openvrpaths.vrpath")) or {}
        listed = any(os.path.realpath(d) == os.path.realpath(dst) for d in vp.get("external_drivers", []) or [])
        if not listed or not os.path.exists(os.path.join(dst, "driver.vrdrivermanifest")):
