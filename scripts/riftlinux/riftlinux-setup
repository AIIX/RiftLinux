# Small helpers


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def backup(path):
    if path in _backed_up or not os.path.exists(path):
        return
    real = os.path.realpath(path)
    shutil.copy2(real, f"{real}.bak-riftlinux-{STAMP}")
    _backed_up.add(path)


def backup_link(path):
    """Before a link is replaced: the link itself kept next to it, pointing where it did. Its target can sit where
    only root writes (another runtime's file in /usr/share/openxr), and it is not changed."""
    if path in _backed_up or not os.path.islink(path):
        backup(path)
        return
    os.symlink(os.readlink(path), f"{path}.bak-riftlinux-{STAMP}")
    _backed_up.add(path)


def write_json(path, data, indent="\t"):
    backup(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp-riftlinux"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=indent)
        f.write("\n")
    os.replace(tmp, os.path.realpath(path) if os.path.islink(path) else path)


class BadSettings(Exception):
    """settings.json is there but cannot be used: nothing gets written into it (written anew it would lose every other
    setting in it)."""


def load_settings(p):
    """settings.json as a dict, {} when it is not there or empty; BadSettings when it cannot be used."""
    try:
        with open(p.settings) as f:
            text = f.read()
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise BadSettings(f"{p.settings} cannot be read ({e.strerror})")
    if not text.strip():
        return {}
    try:
        data = json.loads(text)
    except ValueError as e:
        where = f" (line {e.lineno}, column {e.colno}: {e.msg})" if hasattr(e, "lineno") else ""
        raise BadSettings(f"{p.settings} is not valid JSON{where}")
    if not isinstance(data, dict):
        raise BadSettings(f"{p.settings} holds a JSON {type(data).__name__} instead of an object")
    keep_last_known(p, text)
    return data


def last_known_path(p):
    return p.settings + ".last-known"


def keep_last_known(p, text):
    """A settings file that could be used, kept as settings.json.last-known (as the driver keeps it)."""
    path = last_known_path(p)
    try:
        with open(path) as f:
            if f.read() == text:
                return
    except OSError:
        pass
    try:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError:
        pass


def last_known(p):
    """The last-known settings (a dict) and when they were kept, or (None, None)."""
    path = last_known_path(p)
    data = read_json(path)
    if not isinstance(data, dict):
        return None, None
    return data, time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(path)))


