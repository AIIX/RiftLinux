def settings_problems(s):
    """What in settings.json the driver cannot use as written (it takes its default for that key instead)."""
    problems = []
    for section in sorted({sec for sec, _ in SETTINGS_KEYS} | {"notices", "tracking", "tab"}):
        if section in s and not isinstance(s[section], dict):
            problems.append(f"\"{section}\" should be an object, is {json.dumps(s[section])}: every {section} setting is "
                            "at its default")
    for (section, key), (kind, low, high, default) in SETTINGS_KEYS.items():
        sec = s.get(section)
        if not isinstance(sec, dict) or key not in sec:
            continue
        v = sec[key]
        name = f"{section}.{key}"
        if kind == "bool" and not isinstance(v, bool):
            problems.append(f"{name} should be true or false, is {json.dumps(v)}: the driver uses {default}")
        elif kind == "choice" and v not in high:
            problems.append(f"{name} should be " + " or ".join(f'"{c}"' for c in high) +
                            f", is {json.dumps(v)}: the driver uses {default}")
        elif kind == "number":
            if isinstance(v, bool) or not isinstance(v, (int, float)):
                problems.append(f"{name} should be a number, is {json.dumps(v)}: the driver uses {default}")
            elif (low is not None and v < low) or (high is not None and v > high):
                problems.append(f"{name} is {v:g}, out of range: the driver uses the nearest allowed value "
                                f"(default {default})")
    h = s.get("headset") if isinstance(s.get("headset"), dict) else {}
    above, below = h.get("worn_above", 30), h.get("unworn_below", 15)
    if all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in (above, below)) and below > above:
        problems.append(f"headset.unworn_below ({below:g}) is above headset.worn_above ({above:g}): the driver uses 30 "
                        "and 15")
    return problems


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None


def vdf_load(text):
    """Steam's text key-value files (config.vdf, localconfig.vdf): nested dicts in file order."""
    tokens = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c in " \t\r\n":
            i += 1
        elif c == "/" and text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif c in "{}":
            tokens.append(c)
            i += 1
        elif c == '"':
            out = []
            i += 1
            while i < n and text[i] != '"':
                if text[i] == "\\" and i + 1 < n:
                    out.append({"n": "\n", "t": "\t"}.get(text[i + 1], text[i + 1]))
                    i += 2
                else:
                    out.append(text[i])
                    i += 1
            tokens.append(("s", "".join(out)))
            i += 1
        else:
            j = i
            while j < n and text[j] not in " \t\r\n{}\"":
                j += 1
            tokens.append(("s", text[i:j]))
            i = j
    pos = 0

    def block():
        nonlocal pos
        d = {}
        while pos < len(tokens):
            tok = tokens[pos]
            if tok == "}":
                pos += 1
                return d
            key = tok[1]
            pos += 1
            if pos < len(tokens) and tokens[pos] == "{":
                pos += 1
                d[key] = block()
            elif pos < len(tokens):
                d[key] = tokens[pos][1]
                pos += 1
        return d

    return block()


def vdf_dump(d, depth=0):
    def q(s):
        return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    out = []
    tab = "\t" * depth
    for k, v in d.items():
        if isinstance(v, dict):
            out.append(f"{tab}{q(k)}\n{tab}{{\n{vdf_dump(v, depth + 1)}{tab}}}\n")
        else:
            out.append(f"{tab}{q(k)}\t\t{q(v)}\n")
    return "".join(out)


def vdf_get(d, *keys):
    """A nested value by keys, Steam's keys are not case-sensitive; None when absent."""
    for key in keys:
        if not isinstance(d, dict):
            return None
        d = next((v for k, v in d.items() if k.lower() == key.lower()), None)
    return d


def write_text(path, text):
    backup(path)
    tmp = f"{path}.tmp-riftlinux"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def sysfs(path, name):
    try:
        with open(os.path.join(path, name)) as f:
            return f.read().strip()
    except OSError:
        return None


