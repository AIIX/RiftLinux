WEAR_DEFAULTS = {"worn_above": 30, "unworn_below": 15}


def headset_settings(s):
    return s.get("headset") if isinstance(s.get("headset"), dict) else {}


def save_headset_settings(p, s, headset):
    if headset:
        s["headset"] = headset
    else:
        s.pop("headset", None)
    write_json(p.settings, s)


def wear_test(p, seconds=20):
    """The headset's wear sensor read for a while (SteamVR and the own runtime closed), one line a second."""
    import select
    import time
    busy = busy_runtime()
    if busy:
        print(f"{busy} is running and has the headset: close SteamVR (or the runtime) first.")
        return 1
    path = cv1_hidraw(0)
    if not path:
        print("No Rift CV1 headset found (plug it in, or no access yet: riftlinux-setup check).")
        return 1
    try:
        fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
    except OSError as e:
        print(f"Cannot open {path}: {e.strerror} (riftlinux-setup check shows the device rules).")
        return 1
    s = load_settings(p)
    h = headset_settings(s)
    worn_above = h.get("worn_above", WEAR_DEFAULTS["worn_above"])
    unworn_below = h.get("unworn_below", WEAR_DEFAULTS["unworn_below"])
    print(f"Reading the wear sensor for {seconds} s: put the headset on, then take it off. Worn above {worn_above}, "
          f"not worn below {unworn_below} (the display stays off meanwhile).")
    keep_alive = bytes([0x11, 0x00, 0x00, 0x0B, 0x10, 0x27])  # the driver's: sensor reports for 10 s
    lo_all, hi_all = None, None
    try:
        hid_set_feature(fd, keep_alive)
        start = last_keep_alive = second_start = time.monotonic()
        lo = hi = None
        while time.monotonic() - start < seconds:
            now = time.monotonic()
            if now - last_keep_alive > 9.5:
                hid_set_feature(fd, keep_alive)
                last_keep_alive = now
            if now - second_start >= 1.0:
                if lo is not None:
                    state = "worn" if hi > worn_above else "not worn" if hi < unworn_below else "in between"
                    print(f"  {now - start:4.0f} s  wear sensor {lo}-{hi}  ({state})")
                lo = hi = None
                second_start = now
            ready, _, _ = select.select([fd], [], [], 0.2)
            if not ready:
                continue
            try:
                buf = os.read(fd, 64)
            except BlockingIOError:
                continue
            if len(buf) < 64 or buf[0] != 0x0B:
                continue
            wear = buf[44] | (buf[45] << 8)
            lo = wear if lo is None else min(lo, wear)
            hi = wear if hi is None else max(hi, wear)
            lo_all = wear if lo_all is None else min(lo_all, wear)
            hi_all = wear if hi_all is None else max(hi_all, wear)
    finally:
        os.close(fd)
    if lo_all is not None:
        print(f"Lowest {lo_all}, highest {hi_all}. Worn readings should be above the first level and readings off "
              "the head below the second: riftlinux-setup wear-sensor levels <worn above> <not worn below>, or "
              "riftlinux-setup wear-sensor off.")
    return 0



def cmd_wear_sensor(p, opts):
    """settings.json "headset": wear_sensor, worn_above, unworn_below; read when SteamVR or the runtime starts."""
    if opts.mode == "test":
        return wear_test(p)
    s = load_settings(p)
    h = headset_settings(s)
    if opts.mode == "status":
        if h.get("wear_sensor", True) is False:
            print("Wear sensor: off; the headset counts as worn whenever SteamVR or the runtime runs (the display "
                  "stays on until you quit).")
        else:
            print(f"Wear sensor: on; worn above {h.get('worn_above', WEAR_DEFAULTS['worn_above'])}, not worn below "
                  f"{h.get('unworn_below', WEAR_DEFAULTS['unworn_below'])}; {motion_text(h)}.")
        off = h.get("display_off_after_s")
        print("Headset taken off: " + ("the picture stays on" if isinstance(off, (int, float)) and off < 0 else
                                        f"after {off if isinstance(off, (int, float)) else 5:g} s {not_worn_text(h)}")
              + ".")
        return 0
    if opts.mode == "motion":
        value = opts.values[0] if len(opts.values) == 1 else ""
        if value in MOTION_LEVELS:
            value = str(MOTION_LEVELS[value])
        if value in ("on", "default"):
            h.pop("worn_by_motion", None)
            if value == "default":
                h.pop("worn_by_motion_after_s", None)
        elif value == "off":
            h["worn_by_motion"] = False
        else:
            try:
                seconds = int(value)
            except ValueError:
                seconds = 0
            if not 1 <= seconds <= 60:
                print("riftlinux-setup wear-sensor motion high|medium|low|<seconds, 1 to 60>|off|on|default")
                return 2
            h.pop("worn_by_motion", None)
            h["worn_by_motion_after_s"] = seconds
        save_headset_settings(p, s, h)
        print(f"{motion_text(h)[0].upper()}{motion_text(h)[1:]}; from the next start of SteamVR or the runtime.")
        return 0
    if opts.mode == "levels":
        if len(opts.values) == 1 and opts.values[0] == "default":
            h.pop("worn_above", None)
            h.pop("unworn_below", None)
        else:
            try:
                worn_above, unworn_below = (int(v) for v in opts.values)
            except ValueError:
                print("riftlinux-setup wear-sensor levels <worn above> <not worn below> (for example 25 10), or "
                      "levels default")
                return 2
            if not 0 <= unworn_below <= worn_above:
                print("The 'not worn below' level has to be at most the 'worn above' level.")
                return 2
            h["worn_above"], h["unworn_below"] = worn_above, unworn_below
        save_headset_settings(p, s, h)
        print(f"Wear sensor levels: worn above {h.get('worn_above', WEAR_DEFAULTS['worn_above'])}, not worn below "
              f"{h.get('unworn_below', WEAR_DEFAULTS['unworn_below'])}; from the next start of SteamVR or the runtime.")
        return 0
    if opts.mode == "on":
        h.pop("wear_sensor", None)
        save_headset_settings(p, s, h)
        print("Wear sensor on (from the next start of SteamVR or the runtime): the display switches off when the "
              "headset is taken off.")
    else:
        h["wear_sensor"] = False
        save_headset_settings(p, s, h)
        print("Wear sensor off (from the next start of SteamVR or the runtime): the headset counts as worn whenever "
              "it runs, the display no longer switches off by itself and SteamVR does not go to standby. The OLED "
              "panel stays lit while SteamVR runs: quit SteamVR when you take the headset off for longer.")
    return 0


MOTION_LEVELS = {"high": 8, "medium": 20, "low": 30}


def motion_text(h):
    """Whether moving as on a head counts as worn, from settings.json "headset" (worn_by_motion, _after_s)."""
    if h.get("worn_by_motion", True) is False:
        return "moving as on a head does not count as worn (the wear sensor alone)"
    seconds = h.get("worn_by_motion_after_s", 20)
    seconds = seconds if isinstance(seconds, (int, float)) else 20
    level = next((f" ({name})" for name, s in MOTION_LEVELS.items() if s == seconds), "")
    return f"moving as on a head counts as worn after {seconds:g} s{level}, for a face shield or pad"



def not_worn_text(h):
    """How a headset taken off is shown, from settings.json "headset" (not_worn, black_then_off_min)."""
    if h.get("not_worn") == "off":
        return "display switched off"
    minutes = h.get("black_then_off_min", 10)
    if isinstance(minutes, (int, float)) and minutes < 0:
        return "black, never switched off"
    return f"black, switched off after {minutes if isinstance(minutes, (int, float)) else 10:g} min black"


def cmd_not_worn(p, opts):
    """settings.json headset.not_worn ("black" or "off") and headset.black_then_off_min (minutes; negative never)."""
    s = load_settings(p)
    h = headset_settings(s)
    if opts.mode == "status":
        print(f"Headset taken off: {not_worn_text(h)}.")
        return 0
    if opts.mode == "default":
        h.pop("not_worn", None)
        h.pop("black_then_off_min", None)
    elif opts.mode == "off":
        h["not_worn"] = "off"
        h.pop("black_then_off_min", None)
    else:
        h.pop("not_worn", None)
        h.pop("black_then_off_min", None)
        if opts.minutes == "never":
            h["black_then_off_min"] = -1
        elif opts.minutes is not None:
            try:
                minutes = int(opts.minutes)
            except ValueError:
                print("riftlinux-setup not-worn black [<minutes>|never]|off|default|status")
                return 2
            if minutes < 1:
                print("At least 1 minute (or never).")
                return 2
            h["black_then_off_min"] = minutes
    save_headset_settings(p, s, h)
    print(f"Headset taken off: {not_worn_text(h)}; from the next start of SteamVR or the runtime.")
    if h.get("not_worn") == "off":
        print("Each take-off and put-on is a monitor unplugged and plugged for the desktop (GNOME 48 on NVIDIA kept "
              "GPU memory each time); `riftlinux-setup not-worn black` avoids it.")
    elif h.get("black_then_off_min") == -1:
        print("The display stays on showing black while SteamVR runs; quit SteamVR when you are done.")
    return 0


def cmd_display_off(p, opts):
    """settings.json headset.display_off_after_s: seconds not worn before the display switches off; negative never."""
    s = load_settings(p)
    h = headset_settings(s)
    if opts.when == "status":
        off = h.get("display_off_after_s")
        print("Headset taken off: " + ("the picture stays on" if isinstance(off, (int, float)) and off < 0 else
                                        f"after {off if isinstance(off, (int, float)) else 5:g} s {not_worn_text(h)}")
              + ".")
        return 0
    if opts.when == "default":
        h.pop("display_off_after_s", None)
    elif opts.when == "never":
        h["display_off_after_s"] = -1
    else:
        try:
            seconds = float(opts.when)
        except ValueError:
            print("riftlinux-setup display-off <seconds>|never|default|status")
            return 2
        if seconds < 1:
            print("At least 1 second (or never).")
            return 2
        h["display_off_after_s"] = seconds
    save_headset_settings(p, s, h)
    off = h.get("display_off_after_s")
    if off is None:
        print(f"Headset taken off: after 5 s (the default) {not_worn_text(h)}; from the next start.")
    elif off < 0:
        print("The picture stays on when the headset is taken off, from the next start: the OLED panel stays lit "
              "while SteamVR runs (risk of burn-in on a still picture); quit SteamVR when you are done.")
    else:
        print(f"Headset taken off: after {off:g} s {not_worn_text(h)}; from the next start.")
    return 0


def cmd_uninstall(p, opts):
    found = False
    # From every Steam's list (native, Flatpak, Snap): this folder and the copies made for each.
    for name, config_dir, data_dir, _ in steam_installs():
        vp_path = os.path.join(config_dir, "openvr", "openvrpaths.vrpath")
        vp = read_json(vp_path)
        drivers = (vp or {}).get("external_drivers", []) or []
        ours = {os.path.realpath(p.package), os.path.realpath(user_copy_dir(data_dir))}
        hit = [d for d in drivers if os.path.realpath(d) in ours]
        if not hit:
            continue
        found = True
        where = "SteamVR" if name == "native" else f"{name} Steam's SteamVR"
        if ask(opts, f"Unregister {', '.join(hit)} from {where}?"):
            vp["external_drivers"] = [d for d in drivers if d not in hit]
            write_json(vp_path, vp)
            cfg = config_dir.replace(HOME, "~", 1)
            print(f"unregistered from {where}; settings and calibration stay in {cfg}/riftlinux and {cfg}/monado.")
    if not found:
        print("not registered.")
    print(f"The udev rules stay; to remove them (root): rm /etc/udev/rules.d/{UDEV_NAME} && udevadm control --reload-rules")
    if system_package_dir():
        print("The installed package registers the driver again at the next login or plug-in: remove the package to stop that.")
    return 0


# --------------------------------------------------------------------------------------------------------------------
# Installed system-wide: the package puts the driver in a system directory, but SteamVR runs inside
# Steam's container, which has its own /usr and shares only the home directory. So each user gets a copy in
# ~/.local/share/riftlinux/steamvr/rift-cv1 (kept current from the system one) and that copy is registered.

SYSTEM_DIRS = ["/usr/lib/riftlinux/steamvr/rift-cv1", "/usr/lib64/riftlinux/steamvr/rift-cv1",
               "/usr/local/lib/riftlinux/steamvr/rift-cv1", "/opt/riftlinux/steamvr/rift-cv1"]
MANAGED = ".riftlinux-managed"


def system_package_dir():
    env = os.environ.get("RIFTLINUX_SYSTEM_DIR")
    for d in ([env] if env else []) + SYSTEM_DIRS:
        if d and os.path.exists(os.path.join(d, "driver.vrdrivermanifest")):
            return d
    return None


def user_copy_dir(data=None):
    data = data or os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")
    return os.path.join(data, "riftlinux", "steamvr", "rift-cv1")


FLATPAK_STEAM = os.path.join(HOME, ".var", "app", "com.valvesoftware.Steam")
SNAP_STEAM = os.path.join(HOME, "snap", "steam", "common")


def steam_installs():
    """Each Steam the user has, as its SteamVR sees files: (name, its XDG config dir, a data dir it can read, its
    Steam config dir). Native Steam reads ~/.config and ~/.local/share. Flatpak Steam (com.valvesoftware.Steam) has
    its own XDG dirs under ~/.var/app/com.valvesoftware.Steam and cannot read ~/.local/share; the Snap lives in
    ~/snap/steam/common. A driver must be inside what that Steam sees, registered in that Steam's own list."""
    native_cfg = None
    for root in Paths.steam_roots():
        if not root.startswith((FLATPAK_STEAM, SNAP_STEAM)) and os.path.isdir(os.path.join(root, "config")):
            native_cfg = os.path.join(root, "config")
            break
    out = [("native", XDG_CONFIG, os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), native_cfg)]
    if os.path.isdir(FLATPAK_STEAM):
        out.append(("Flatpak", os.path.join(FLATPAK_STEAM, "config"), os.path.join(FLATPAK_STEAM, "data"),
                    os.path.join(FLATPAK_STEAM, ".local", "share", "Steam", "config")))
    if os.path.isdir(SNAP_STEAM):
        out.append(("Snap", os.path.join(SNAP_STEAM, ".config"), os.path.join(SNAP_STEAM, ".local", "share"),
                    os.path.join(SNAP_STEAM, ".local", "share", "Steam", "config")))
    return out


def tree_stamp(d):
    """Size and modification time of every file: changes whenever the package is updated."""
    out = []
    for root, dirs, files in os.walk(d):
        dirs.sort()
        for f in sorted(files):
            if f == MANAGED:
                continue
            st = os.stat(os.path.join(root, f))
            out.append(f"{os.path.relpath(os.path.join(root, f), d)}:{st.st_size}:{int(st.st_mtime)}")
    return "\n".join(out)


def sync_user_copy(system_dir, log, dst=None):
    """Copy the system driver to the user's directory (@p dst, default the native one) when it is missing or older;
    replaced as a whole, so a running SteamVR keeps the files it has open."""
    dst = dst or user_copy_dir()
    stamp = tree_stamp(system_dir)
    try:
        if open(os.path.join(dst, MANAGED)).read() == stamp:
            return dst, False
    except OSError:
        pass
    parent = os.path.dirname(dst)
    os.makedirs(parent, exist_ok=True)
    tmp = dst + f".new-{os.getpid()}"
    shutil.copytree(system_dir, tmp, symlinks=False)
    with open(os.path.join(tmp, MANAGED), "w") as f:
        f.write(stamp)
    if os.path.exists(dst):
        old = dst + f".old-{os.getpid()}"
        os.rename(dst, old)
        os.rename(tmp, dst)
        if os.path.exists(os.path.join(old, MANAGED)):
            shutil.rmtree(old, ignore_errors=True)  # our own earlier copy, never anything else
    else:
        os.rename(tmp, dst)
    log(f"driver copied from {system_dir} to {dst}")
    return dst, True


def openvrpaths_register(path, log, config_dir=None):
    """Register path as SteamVR's driver (and only it under the name "monado") in the list under @p config_dir (that
    Steam's XDG config dir, default the native one); creates the list if SteamVR never ran (SteamVR fills in the
    rest on its first start)."""
    vp_path = os.path.join(config_dir or XDG_CONFIG, "openvr", "openvrpaths.vrpath")
    vp = read_json(vp_path)
    if vp is None:
        vp = {"external_drivers": [path], "jsonid": "vrpathreg", "version": 1}
        write_json(vp_path, vp)
        log(f"SteamVR has not run yet: driver list created with {path}")
        return True
    drivers = vp.get("external_drivers", []) or []
    keep = []
    for d in drivers:
        if os.path.realpath(d) == os.path.realpath(path):
            continue
        m = read_json(os.path.join(d, "driver.vrdrivermanifest")) or {}
        if m.get("name") == DRIVER_NAME:
            log(f"unregistered another driver named \"{DRIVER_NAME}\": {d} (its files stay)")
            continue
        keep.append(d)
    new = keep + [path]
    if new == drivers:
        return False
    vp["external_drivers"] = new
    write_json(vp_path, vp)
    log(f"registered {path} with SteamVR")
    return True


def cmd_register(p, opts):
    logs = []

    def log(msg):
        logs.append(msg)
        if not opts.quiet:
            print(msg)

    if not x86_64():
        # The driver is built for x86-64: registered here, SteamVR could only fail to load it.
        log("not an x86-64 computer: the driver is not registered")
        return 0
    sysdir = system_package_dir()
    src = sysdir or (p.package if os.path.exists(p.manifest) else None)
    if src is None:
        log("no installed driver found")
        return 0
    # Every Steam the user has (native, Flatpak, Snap) gets a copy it can read, in its own list. Without an installed
    # package (a driver folder run from where it is) only the native Steam, which can read any folder.
    for name, config_dir, data_dir, steam_config in steam_installs() if sysdir else steam_installs()[:1]:
        def logn(msg, name=name):
            log(msg if name == "native" else f"{name} Steam: {msg}")

        path = sync_user_copy(sysdir, logn, user_copy_dir(data_dir))[0] if sysdir else src
        openvrpaths_register(path, logn, config_dir)
        # Lift SteamVR's safe-mode block (set after a crash): one more try at each login or headset plug-in.
        vrsettings = os.path.join(steam_config, "steamvr.vrsettings") if steam_config else None
        if vrsettings and os.path.exists(vrsettings):
            vs = read_json(vrsettings) or {}
            sect = vs.get("driver_" + DRIVER_NAME, {})
            if sect.get("blocked_by_safe_mode") or sect.get("enable") is False:
                sect["blocked_by_safe_mode"] = False
                sect["enable"] = True
                vs["driver_" + DRIVER_NAME] = sect
                write_json(vrsettings, vs, indent=3)
                logn("SteamVR had blocked the driver (safe mode): enabled again")
            # SteamVR 2.18 starts without SteamVR Home unless it is switched on; one the user switched off stays off.
            steamvr = vs.get("steamvr", {})
            if "enableHomeApp" not in steamvr:
                steamvr["enableHomeApp"] = True
                vs["steamvr"] = steamvr
                write_json(vrsettings, vs, indent=3)
                logn("SteamVR Home switched on (SteamVR 2.18 starts without it)")
    if logs:
        try:
            d = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "riftlinux")
            os.makedirs(d, exist_ok=True)
            with open(os.path.join(d, "register.log"), "a") as f:
                for m in logs:
                    f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} {m}\n")
        except OSError:
            pass
    return 0


# --------------------------------------------------------------------------------------------------------------------
# Pairing. Protocol from ouvrt (Philipp Zabel, rift-radio.c / rift.c, LGPL-2.1-or-later OR BSL-1.0), checked against
# a USB capture of the Oculus software pairing both Touch controllers, and made the same way: the headset restarts into
# radio pairing mode (feature report 0x06 = 2); a controller held in pairing mode reports its address and the headset
# it is paired to; four radio writes bind it to this headset; about 3 s later the headset restarts into normal mode
# (0x06 = 0). One controller per visit to pairing mode, and a controller is bound again even when it already belongs
# to this headset, as the Oculus software does. The Remote's values (type 1, channel 750) are ouvrt's; the capture had
# no Remote.

PAIR_NAMES = {1: "Remote", 2: "left Touch", 3: "right Touch"}
PAIR_CHANNEL = {1: 750, 2: 1000, 3: 1250}


def hid_ioc(nr, size):
    return (3 << 30) | (size << 16) | (ord("H") << 8) | nr


def hid_set_feature(fd, data):
    import fcntl
    buf = bytearray(data)
    fcntl.ioctl(fd, hid_ioc(0x06, len(buf)), buf)


def hid_get_feature(fd, report_id, size):
    import fcntl
    buf = bytearray(size)
    buf[0] = report_id
    fcntl.ioctl(fd, hid_ioc(0x07, size), buf)
    return bytes(buf)


def cv1_hidraw(interface):
    for dev in sorted(glob_hidraw()):
        try:
            uevent = open(os.path.join(dev, "device", "uevent")).read()
        except OSError:
            continue
        if "HID_ID=0003:00002833:00000031" in uevent and f"input{interface}" in uevent:
            return "/dev/" + os.path.basename(dev)
    return None


def glob_hidraw():
    try:
        return [os.path.join("/sys/class/hidraw", n) for n in os.listdir("/sys/class/hidraw")]
    except OSError:
        return []


def radio_transfer(fd, a, b, c):
    import time
    hid_set_feature(fd, bytes([0x1A, 0, 0, a, b, c]))
    # Binding a controller keeps the radio busy for about 1 s.
    end = time.monotonic() + 5.0
    while True:
        r = hid_get_feature(fd, 0x1A, 6)
        if not r[3] & 0x80:
            break
        if time.monotonic() > end:
            raise IOError("radio busy")
        time.sleep(0.002)
    if r[3] & 0x08:
        raise IOError("radio error")


def radio_read(fd, a, b, c):
    radio_transfer(fd, a, b, c)
    return hid_get_feature(fd, 0x1B, 31)[3:]


def radio_write(fd, a, b, c, payload):
    data = bytes([0x1B, 0, 0]) + bytes(payload) + bytes(28 - len(payload))
    hid_set_feature(fd, data)
    radio_transfer(fd, a, b, c)


def boot_mode(fd):
    return hid_get_feature(fd, 0x06, 4)[3]


def wait_for_headset(present, timeout=20.0):
    import time
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        node = cv1_hidraw(0)
        if bool(node) == present:
            return node
        time.sleep(0.25)
    return cv1_hidraw(0) if present else None


def restart_headset(fd, mode):
    """Restart the headset into a boot mode; returns the new interface-0 node (the old fd is gone)."""
    import time
    try:
        hid_set_feature(fd, bytes([0x06, 0, 0, mode]))
    except OSError:
        pass  # It may go away before the call returns.
    try:
        os.close(fd)
    except OSError:
        pass
    wait_for_headset(False, 5.0)
    time.sleep(0.5)
    node = wait_for_headset(True, 20.0)
    time.sleep(1.0)
    return node


def busy_runtime():
    names = {"vrserver", "vrcompositor", "monado-service"}
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                if open(f"/proc/{pid}/comm").read().strip() in names:
                    return open(f"/proc/{pid}/comm").read().strip()
            except OSError:
                pass
    return None


PAIR_HOLD_S = 3.0  # After the last write the Oculus software waits about 2.7 s before leaving pairing mode.
# In pairing mode the headset reports nothing (no radio messages) without a keep-alive: the Oculus software sends
# feature report 0x08 with a 10 s interval every 3 s, from entering pairing mode until it leaves.
PAIR_KEEPALIVE = bytes([0x08, 0, 0, 0x10, 0x27])
PAIR_KEEPALIVE_EVERY_S = 3.0


class PairKeepAlive:
    def __init__(self, fd):
        self.fd = fd
        self.next = 0.0

    def tick(self):
        import time
        now = time.monotonic()
        if now >= self.next:
            hid_set_feature(self.fd, PAIR_KEEPALIVE)
            self.next = now + PAIR_KEEPALIVE_EVERY_S

    def sleep(self, seconds):
        import time
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            self.tick()
            time.sleep(min(0.1, max(0.0, end - time.monotonic())))


def wait_pairing_message(rfd, timeout, skip_types, keep_alive):
    """The next pairing message of a controller held in pairing mode, as (type, device address, the radio address it
    is paired to, firmware), or None after @p timeout seconds."""
    import time
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        keep_alive.tick()
        try:
            r = os.read(rfd, 64)
        except BlockingIOError:
            time.sleep(0.01)
            continue
        if len(r) < 59 or r[0] != 0x0C:
            continue
        for k in range(2):
            m = r[3 + 28 * k: 3 + 28 * (k + 1)]
            if m[:4] != b"\x1a\x00\x03\x01":
                continue
            dtype = m[6]
            if dtype not in PAIR_NAMES or dtype in skip_types:
                continue
            fw = bytes(m[17:25]).split(b"\0")[0].decode(errors="replace")
            return dtype, struct.unpack_from("<I", m, 7)[0], bytes(m[11:16]), fw
    return None


def bind_controller(fd, address, dtype, dev_addr):
    """The four radio writes that bind a controller to this headset (data report first, then the command)."""
    radio_write(fd, 0x04, 0x07, 0x05, struct.pack("<I", dev_addr))
    step = bytearray(28)
    step[0], step[1], step[2] = 0x11, 0x0F, dtype
    step[3:7] = address[:4]
    step[7:12] = address[:5]
    struct.pack_into("<H", step, 12, PAIR_CHANNEL[dtype])
    struct.pack_into("<H", step, 16, 2000)
    radio_write(fd, 0x04, 0x09, 0x05, step)
    radio_write(fd, 0x04, 0x09, 0x05, bytes([0x21]))
    radio_write(fd, 0x04, 0x08, 0x05, b"")


def reopen_headset(fd, mode):
    """Restarts the headset into @p mode; the new interface-0 descriptor, or -1 when it did not come back in it."""
    node = restart_headset(fd, mode)
    if not node:
        print("The headset did not come back; unplug and replug its USB cable.")
        return -1
    fd = os.open(node, os.O_RDWR)
    if boot_mode(fd) != mode:
        os.close(fd)
        print("The headset did not enter " + ("pairing" if mode == 2 else "normal") + " mode; replug its USB cable.")
        return -1
    return fd


def driver_request(request, timeout=5.0):
    """One request to the running SteamVR driver's socket (each Steam's cache dir: the driver lives in its
    container); its answer as a dict, or None when no driver answers."""
    import socket
    dirs = [os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")]
    for _, config_dir, _, _ in steam_installs()[1:]:
        dirs.append(os.path.join(os.path.dirname(config_dir), "cache"))
    for d in dirs:
        path = os.path.join(d, "riftlinux", "driver.sock")
        if not os.path.exists(path):
            continue
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
                c.settimeout(timeout)
                c.connect(path)
                c.sendall((json.dumps(request) + "\n").encode())
                answer = b""
                while not answer.endswith(b"\n"):
                    chunk = c.recv(4096)
                    if not chunk:
                        break
                    answer += chunk
            return json.loads(answer.decode() or "null")
        except (OSError, ValueError):
            continue
    return None


def cmd_recalibrate(p, opts):
    running = busy_runtime()
    if running in ("vrserver", "vrcompositor"):
        answer = driver_request({"recalibrate": True})
        if answer is None:
            print("SteamVR runs, but its RiftLinux driver did not answer: use the Rift tab's Measure button "
                  "(Display & status page).")
            return 2
        if answer.get("started"):
            print("Measuring every sensor again: put the headset on, face the sensors and slowly turn your head left "
                  "and right, then up and down, until the measuring notice goes away. Your floor carries over; if it "
                  "is off afterwards, use Set floor in the Rift tab.")
            return 0
        print("Not now: the sensors are being solved right now; try again in a moment.")
        return 1
    if running == "monado-service":
        print("RiftLinux's own runtime is running: press Measure in the Rift panel (Display & status page).")
        return 1
    # Nothing running: the saved placement set aside (not deleted) for every Steam's config and the own runtime's,
    # so the next start measures every sensor anew.
    moved = []
    for _, config_dir, _, _ in steam_installs():
        rig = os.path.join(config_dir, "monado", "constellation", "rig.json")
        if os.path.exists(rig):
            os.replace(rig, rig + ".before-recalibration")
            moved.append(rig.replace(HOME, "~", 1))
    if moved:
        print("Set aside: " + ", ".join(moved) + " (as .before-recalibration). The next start of SteamVR (or "
              "riftlinux-runtime) measures every sensor again: put the headset on, face the sensors and slowly turn "
              "your head left and right, then up and down, until the measuring notice goes away. Then check the "
              "floor (Set floor in the Rift tab).")
    else:
        print("No saved sensor placement: the next start measures the sensors anyway.")
    return 0


def cmd_pair(p, opts):
    import time
    busy = busy_runtime()
    if busy:
        print(f"{busy} is running and holds the headset: close SteamVR (or the Monado session) first.")
        return 2
    node = cv1_hidraw(0)
    if not node:
        print("No Rift CV1 headset found (USB plugged in, and its box on?).")
        return 2
    fd = os.open(node, os.O_RDWR)
    try:
        mode = boot_mode(fd)
    except OSError as e:
        os.close(fd)
        print(f"Could not talk to the headset ({e}); check `riftlinux-setup check` (device access).")
        return 2
    paired = []
    done_types = set()
    try:
        while True:
            if mode != 2:
                print("Restarting the headset into pairing mode (it leaves USB for a few seconds) ...")
                fd = reopen_headset(fd, 2)
                if fd < 0:
                    return 2
                mode = 2
            address = radio_read(fd, 0x05, 0x03, 0x05)[:5]
            keep_alive = PairKeepAlive(fd)
            keep_alive.tick()
            radio_node = cv1_hidraw(1)
            if not radio_node:
                print("The headset's radio interface did not appear.")
                return 2
            rfd = os.open(radio_node, os.O_RDONLY | os.O_NONBLOCK)
            print("\nPairing mode (headset radio " + " ".join(f"{b:02x}" for b in address) + "). One controller at a "
                  "time: hold the Oculus button and Y (left controller) or the Oculus button and B (right controller) "
                  "until its light blinks; on the Remote, hold its back button. Waiting up to "
                  f"{opts.timeout} s; Ctrl+C to finish.")
            try:
                got = wait_pairing_message(rfd, opts.timeout, done_types, keep_alive)
            except KeyboardInterrupt:
                print()
                got = None
            finally:
                os.close(rfd)
            if got is None:
                break
            dtype, dev_addr, cur, fw = got
            name = PAIR_NAMES[dtype]
            if cur == address:
                print(f"{name} {dev_addr:08x} (firmware {fw}): already paired with this headset; pairing it again ...")
            else:
                print(f"{name} {dev_addr:08x} (firmware {fw}), paired to {' '.join(f'{b:02x}' for b in cur)}: "
                      "pairing it with this headset ...")
            bind_controller(fd, address, dtype, dev_addr)
            paired.append(name)
            done_types.add(dtype)
            print(f"{name}: paired.")
            keep_alive.sleep(PAIR_HOLD_S)
            print("Restarting the headset in normal mode ...")
            fd = reopen_headset(fd, 0)
            if fd < 0:
                return 2
            mode = 0
            if {2, 3} <= done_types:
                break
            print("Next controller (Ctrl+C if there is none).")
    except OSError as e:
        print(f"The headset's radio did not answer ({e}).")
        return 2
    finally:
        if fd >= 0:
            if mode == 2:
                print("Restarting the headset in normal mode ...")
                fd = reopen_headset(fd, 0)
                if fd >= 0:
                    print("Headset back in normal mode.")
            if fd >= 0:
                os.close(fd)
    print("Paired: " + (", ".join(paired) if paired else "nothing") + ".")
    return 0


def main():
    here = os.path.dirname(os.path.realpath(__file__))
    if not os.path.exists(os.path.join(here, "driver.vrdrivermanifest")):
        # Installed in /usr/bin: the driver SteamVR uses is the user's copy of the system one.
        here = user_copy_dir() if os.path.exists(os.path.join(user_copy_dir(), "driver.vrdrivermanifest")) else \
            (system_package_dir() or here)
    ap = argparse.ArgumentParser(prog="riftlinux-setup", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("--package", default=here)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--yes", action="store_true")
    ap.add_argument("--print-root", action="store_true")
    sub = ap.add_subparsers(dest="cmd", required=True)
    ck = sub.add_parser("check")
    ck.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    i = sub.add_parser("install")
    i.add_argument("--yes", action="store_true", default=argparse.SUPPRESS)
    i.add_argument("--openxr", choices=["steamvr", "keep"])
    i.add_argument("--direct-mode", choices=["on", "off"])
    # --yes after the command too, as the usage shows it.
    rp = sub.add_parser("repair")
    rp.add_argument("--yes", action="store_true", default=argparse.SUPPRESS)
    fx = sub.add_parser("fix")
    fx.add_argument("what", nargs="?", choices=["last-known"])
    fx.add_argument("--yes", action="store_true", default=argparse.SUPPRESS)
    d = sub.add_parser("direct-mode")
    d.add_argument("mode", choices=["on", "off", "status"])
    nv = sub.add_parser("nvidia-vrr")
    nv.add_argument("action", choices=["status", "conceal", "restore"])
    un = sub.add_parser("uninstall")
    un.add_argument("--yes", action="store_true", default=argparse.SUPPRESS)
    rg = sub.add_parser("register")
    rg.add_argument("--quiet", action="store_true")
    sub.add_parser("recalibrate")
    rc = sub.add_parser("record")
    rc.add_argument("mode", choices=["on", "off", "status"])
    au = sub.add_parser("autostart")
    au.add_argument("mode", choices=["on", "off", "status", "trigger", "quit-unused"])
    au.add_argument("value", nargs="?")
    cs = sub.add_parser("controller-sleep")
    cs.add_argument("mode", choices=["3", "5", "7", "off", "status"])
    sb = sub.add_parser("standby")
    sb.add_argument("mode", choices=["worn", "pick-up", "status"])
    gm = sub.add_parser("game-menu")
    gm.add_argument("mode", choices=["close", "keep", "status"])
    ws = sub.add_parser("wear-sensor")
    ws.add_argument("mode", choices=["on", "off", "status", "test", "levels", "motion"])
    ws.add_argument("values", nargs="*")
    do = sub.add_parser("display-off")
    do.add_argument("when")
    nw = sub.add_parser("not-worn")
    nw.add_argument("mode", choices=["black", "off", "default", "status"])
    nw.add_argument("minutes", nargs="?")
    pp = sub.add_parser("pair")
    pp.add_argument("--timeout", type=int, default=90)
    opts = ap.parse_args()
    p = Paths(opts.package)
    if opts.cmd == "check":
        return cmd_check(p, opts)
    if opts.cmd == "install":
        return cmd_fix(p, opts)
    if opts.cmd == "repair":
        return cmd_fix(p, opts, REPAIR)
    if opts.cmd == "fix":
        return cmd_fix_last_known(p, opts) if opts.what == "last-known" else cmd_force(p, opts)
    if opts.cmd == "direct-mode":
        return cmd_direct(p, opts)
    if opts.cmd == "register":
        return cmd_register(p, opts)
    if opts.cmd == "nvidia-vrr":
        return cmd_nvidia_vrr(p, opts)
    if opts.cmd == "recalibrate":
        return cmd_recalibrate(p, opts)
    if opts.cmd == "pair":
        return cmd_pair(p, opts)
    if opts.cmd == "record":
        return cmd_record(p, opts)
    if opts.cmd == "autostart":
        return cmd_autostart(p, opts)
    if opts.cmd == "controller-sleep":
        return cmd_controller_sleep(p, opts)
    if opts.cmd == "standby":
        return cmd_standby(p, opts)
    if opts.cmd == "game-menu":
        return cmd_game_menu(p, opts)
    if opts.cmd == "wear-sensor":
        return cmd_wear_sensor(p, opts)
    if opts.cmd == "display-off":
        return cmd_display_off(p, opts)
    if opts.cmd == "not-worn":
        return cmd_not_worn(p, opts)
    return cmd_uninstall(p, opts)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BadSettings as e:
        print(f"{e}; the settings were not changed. Fix it by hand, or put the last good settings back with "
              "riftlinux-setup fix last-known.", file=sys.stderr)
        sys.exit(2)
