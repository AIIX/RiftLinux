def run_root(cmds, opts):
    if not cmds:
        return True
    script = " && ".join(cmds)
    if opts.print_root:
        print("Run as root:\n  " + "\n  ".join(cmds))
        return False
    graphical = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    if graphical and shutil.which("pkexec"):
        r = subprocess.run(["pkexec", "sh", "-c", script])
        if r.returncode == 0:
            return True
    if sys.stdin.isatty() and shutil.which("sudo"):
        r = subprocess.run(["sudo", "sh", "-c", script])
        if r.returncode == 0:
            return True
    print("Could not get root here. Run these as root, then `riftlinux-setup check`:\n  " + "\n  ".join(cmds))
    return False


def ask(opts, question):
    if opts.yes:
        return True
    if not sys.stdin.isatty():
        return False
    return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")


SYMBOL = {"ok": "ok   ", "info": "info ", "warn": "WARN ", "fix": "TODO ", "error": "ERROR"}


def report(results, as_json):
    if as_json:
        print(json.dumps({"checks": [{k: v for k, v in r.items() if k != "fix"} | {"fixable": r["fix"] is not None or
                                                                                  bool(r["root_cmds"])}
                                     for r in results]}, indent=2))
        return
    for r in results:
        print(f"{SYMBOL[r['state']]} {r['title']}: {r['detail']}")


def cmd_check(p, opts):
    results = [c(p, opts) for c in CHECKS]
    report(results, opts.json)
    if any(r["state"] == "error" for r in results):
        return 2
    return 1 if any(r["state"] in ("fix", "warn") for r in results) else 0


def cmd_fix(p, opts, only=None):
    results = [c(p, opts) for c in CHECKS]
    report(results, opts.json)
    if any(r["state"] == "error" and r["id"] in ("steam", "package") for r in results):
        print("\nFix the errors above first.")
        return 2
    todo = [r for r in results if (r["fix"] or r["root_cmds"]) and r["state"] in ("fix", "warn")
            and (only is None or r["id"] in only)]
    if not todo:
        print("\nNothing to change.")
        return 0
    print()
    changed = False
    root = []
    for r in todo:
        if r["fix"] and ask(opts, f"{r['title']}: {r['detail']} Change it?"):
            r["fix"]()
            print(f"  done: {r['title']}")
            changed = True
        elif r["root_cmds"] and ask(opts, f"{r['title']}: {r['detail']} Change it (needs root)?"):
            root += r["root_cmds"]
    if root:
        changed = run_root(root, opts) or changed
    if changed:
        print("\nAfter the changes:")
        report([c(p, opts) for c in CHECKS], False)
        print("\nStart SteamVR from Steam (not from a terminal) so it runs in Steam's runtime.")
    return 0


def cmd_fix_last_known(p, opts):
    """riftlinux-setup fix last-known: a settings.json that cannot be used is moved aside (kept) and the last good one
    put back; without one, riftlinux-setup fix runs after the move. One question (none with --yes)."""
    try:
        load_settings(p)
        print(f"{p.settings} can be used: nothing to put back.")
        return 0
    except BadSettings as e:
        problem = str(e)
    known, when = last_known(p)
    aside = f"{p.settings}.broken-{STAMP}"
    print(f"{problem}.")
    if known is not None:
        print(f"It is kept as {aside}, and the last good settings (from {when}) are put back; most of them apply "
              "from the next start of SteamVR or the runtime.")
    else:
        print(f"There are no last good settings: it is kept as {aside}, the settings start from the defaults, and "
              "riftlinux-setup fix then checks the rest (it asks before it changes anything).")
    if not ask(opts, "\nGo ahead?"):
        print("Nothing changed.")
        return 1
    os.replace(p.settings, aside)
    if known is not None:
        shutil.copy2(last_known_path(p), p.settings)
        print(f"Done: {p.settings} is the last good one again; the broken one is {aside}.")
        return 0
    print(f"Done: the broken file is {aside}; the settings are at their defaults.\n")
    return cmd_force(p, opts)


def cmd_force(p, opts):
    """riftlinux-setup fix: the configuration RiftLinux is tested with, all of it in one go: SteamVR's OpenXR and OpenVR
    runtimes, this driver as SteamVR's only headset driver, SteamVR's settings, direct mode, the devices' rules and
    power, and what other setups left behind. One question for everything (none with --yes)."""
    opts.force = True
    opts.openxr = "steamvr"
    opts.direct_mode = "on"
    if steamvr_busy():
        print("Close SteamVR first (it writes its settings back as it quits), then run this again.")
        return 1
    results = [c(p, opts) for c in CHECKS]
    if any(r["state"] == "error" and r["id"] in ("steam", "package") for r in results):
        report(results, opts.json)
        print("\nFix the errors above first.")
        return 2
    todo = [r for r in results if (r["fix"] or r["root_cmds"]) and r["state"] in ("fix", "warn")]
    by_hand = [r for r in results if r["state"] in ("warn", "error") and r not in todo]
    if not todo:
        report(results, opts.json)
        if by_hand:
            print("\nNothing this tool can change; still to do (above): " + ", ".join(r["title"] for r in by_hand) + ".")
            return 1
        print("\nNothing to change: this computer has the configuration RiftLinux is tested with.")
        return 0
    print("These will be changed (every file is kept as <file>.bak-riftlinux-" + STAMP + "; nothing is deleted):")
    for r in todo:
        print(f"  - {r['title']}: {r['detail']}" + (" (needs root)" if r["root_cmds"] and not r["fix"] else ""))
    if not ask(opts, "\nChange all of them?"):
        print("Nothing changed.")
        return 1
    root = []
    for r in todo:
        if r["fix"]:
            r["fix"]()
            print(f"  done: {r['title']}")
        else:
            root += r["root_cmds"]
    if root:
        run_root(root, opts)
    print("\nAfter the changes:")
    after = [c(p, opts) for c in CHECKS]
    report(after, False)
    left = [r for r in after if r["state"] in ("warn", "error", "fix")]
    if left:
        print("\nStill to do (above): " + ", ".join(r["title"] for r in left) + ".")
    if any(r["id"] in ("env",) for r in todo):
        print("Log out and back in for the changed login files to count.")
    print("Then start Steam from the desktop and put the headset on (SteamVR starts).")
    return 0 if not left else 1


