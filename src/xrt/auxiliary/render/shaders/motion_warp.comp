//
// Motion smoothing: the previous frame's finest level turned to the new frame's head orientation, so that
// what is left between the two is the scene's own movement (and the head's translation), as ASW does. Pixels the
// previous frame did not cover are marked invalid (alpha 0).
//
// push.v0..v2: rows of the homography from this frame's (u, v, 1) to the previous frame's (u, v, 1) * w.

#version 460
#extension GL_GOOGLE_include_directive : require
#include "motion.inc.glsl"

layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 2, rgba8) uniform writeonly restrict image2D target;

void main()
{
	ivec2 size = imageSize(target);
	ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(xy, size))) {
		return;
	}

	vec3 p = vec3((vec2(xy) + 0.5) / vec2(size), 1.0);
	vec3 h = vec3(dot(push.v0.xyz, p), dot(push.v1.xyz, p), dot(push.v2.xyz, p));
	vec4 c = vec4(0.0);
	if (h.z > 1e-6) {
		vec2 uv = h.xy / h.z;
		if (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)))) {
			c = vec4(textureLod(source, uv, 0.0).rgb, 1.0);
		}
	}
	imageStore(target, xy, c);
}
